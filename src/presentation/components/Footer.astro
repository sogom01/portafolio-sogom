---
const year = new Date().getFullYear();
const emailUser = 'sog981';
const emailDomain = 'gmail.com';
---

<footer
  role="contentinfo"
  class="mt-auto border-t border-[var(--color-border)] bg-[var(--color-bg)] dark:border-[var(--color-border-dark)] dark:bg-[var(--color-bg-dark)]"
>
  <div
    class="mx-auto flex w-full max-w-6xl flex-col items-start justify-between gap-6 px-4 py-8 sm:px-6 sm:py-10 md:flex-row md:items-center lg:px-8"
  >
    <address
      class="text-sm text-[var(--color-muted)] not-italic dark:text-[var(--color-muted-dark)]"
    >
      <p>
        <span class="font-medium text-[var(--color-fg)] dark:text-[var(--color-fg-dark)]">
          Juan Sebastián Osorio Gómez
        </span>
      </p>
      <p>
        © {year}. Hecho con Astro y Tailwind. <a
          href="/"
          class="underline hover:text-[var(--color-accent)]">JSO</a
        >.
      </p>
    </address>

    <nav aria-label="Redes y contacto">
      <ul class="flex items-center gap-2">
        <li>
          <a
            href="https://github.com/sogom01"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub (se abre en nueva pestaña)"
            class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-[var(--color-border)] text-[var(--color-muted)] hover:text-[var(--color-accent)] dark:border-[var(--color-border-dark)] dark:text-[var(--color-muted-dark)]"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path
                d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.27-1.68-1.27-1.68-1.04-.71.08-.69.08-.69 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.69 1.24 3.35.95.1-.74.4-1.24.73-1.53-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.12 3.05.74.81 1.18 1.84 1.18 3.1 0 4.42-2.69 5.39-5.26 5.68.42.36.78 1.07.78 2.16v3.2c0 .31.21.67.8.56C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z"
              ></path>
            </svg>
          </a>
        </li>
        <li>
          <a
            href="https://linkedin.com/in/PLACEHOLDER"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn (se abre en nueva pestaña)"
            class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-[var(--color-border)] text-[var(--color-muted)] hover:text-[var(--color-accent)] dark:border-[var(--color-border-dark)] dark:text-[var(--color-muted-dark)]"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path
                d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.64-1.85 3.37-1.85 3.61 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM3.56 20.45h3.56V9H3.56v11.45z"
              ></path>
            </svg>
          </a>
        </li>
        <li>
          <button
            id="email-btn"
            type="button"
            data-u={emailUser}
            data-d={emailDomain}
            aria-label="Escribirme un correo"
            class="inline-flex h-9 items-center gap-2 rounded-md border border-[var(--color-border)] px-3 text-sm text-[var(--color-muted)] hover:text-[var(--color-accent)] dark:border-[var(--color-border-dark)] dark:text-[var(--color-muted-dark)]"
          >
            <svg
              class="h-4 w-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <rect x="3" y="5" width="18" height="14" rx="2"></rect>
              <path d="m3 7 9 6 9-6"></path>
            </svg>
            Email
          </button>
        </li>
      </ul>
    </nav>
  </div>
</footer>

<script is:inline>
  (function () {
    const btn = document.getElementById('email-btn');
    if (!btn) return;
    btn.addEventListener('click', () => {
      const u = btn.getAttribute('data-u');
      const d = btn.getAttribute('data-d');
      if (!u || !d) return;
      const subject = encodeURIComponent('Contacto desde el portafolio');
      window.location.href = `mailto:${u}@${d}?subject=${subject}`;
    });
  })();
</script>
