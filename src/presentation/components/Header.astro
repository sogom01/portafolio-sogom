---
const navItems = [
  { href: '#proyectos', label: 'Proyectos', no: '01' },
  { href: '#sobre-mi', label: 'Sobre mí', no: '02' },
  { href: '#servicios', label: 'Servicios', no: '03' },
] as const;
---

<header
  role="banner"
  id="site-header"
  class="sticky top-0 z-30 border-b border-[var(--color-border)] bg-[var(--color-bg)]/90 backdrop-blur-md transition-shadow dark:border-[var(--color-border-dark)] dark:bg-[var(--color-bg-dark)]/90"
>
  <div class="mx-auto flex w-full max-w-6xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
    <a
      href="#inicio"
      class="text-base font-semibold tracking-tight transition-colors hover:text-[var(--color-accent)]"
      aria-label="Volver al inicio"
    >
      SOGOM<span class="text-[var(--color-accent)]">.</span>
    </a>

    <!-- Menú móvil -->
    <details class="relative sm:hidden">
      <summary
        class="cursor-pointer list-none rounded-md border border-[var(--color-border)] bg-[var(--color-surface)] px-3 py-1.5 text-sm dark:border-[var(--color-border-dark)] dark:bg-[var(--color-surface-dark)]"
        aria-label="Abrir menú de navegación"
      >
        Menú
      </summary>
      <nav
        aria-label="Principal (móvil)"
        class="absolute right-0 mt-2 w-52 rounded-xl border border-[var(--color-border)] bg-[var(--color-bg)] p-2 shadow-xl dark:border-[var(--color-border-dark)] dark:bg-[var(--color-bg-dark)]"
      >
        <ul class="flex flex-col gap-1">
          {
            navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="flex items-center gap-2.5 rounded-lg px-3 py-2.5 text-sm text-[var(--color-muted)] transition-colors hover:bg-[var(--color-surface)] hover:text-[var(--color-fg)] dark:text-[var(--color-muted-dark)] dark:hover:bg-[var(--color-surface-dark)]"
                >
                  <span class="font-mono text-[10px] text-[var(--color-accent)]/70">{item.no}</span>
                  {item.label}
                </a>
              </li>
            ))
          }
          <li
            class="mt-1 border-t border-[var(--color-border)] pt-1 dark:border-[var(--color-border-dark)]"
          >
            <a
              href="#contacto"
              class="block rounded-lg bg-[var(--color-accent)] px-3 py-2.5 text-center text-sm font-medium text-white transition-colors hover:bg-[var(--color-accent-hover)]"
            >
              Contacto
            </a>
          </li>
        </ul>
      </nav>
    </details>

    <!-- Navegación desktop -->
    <nav aria-label="Principal" class="hidden sm:block">
      <ul class="flex items-center gap-0.5">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class="group flex items-center gap-1.5 rounded-md px-3 py-1.5 text-sm text-[var(--color-muted)] transition-colors hover:text-[var(--color-fg)] dark:text-[var(--color-muted-dark)] dark:hover:text-[var(--color-fg-dark)]"
              >
                <span class="font-mono text-[10px] text-[var(--color-muted)]/50 transition-colors group-hover:text-[var(--color-accent)]/70 dark:text-[var(--color-muted-dark)]/50">
                  {item.no}
                </span>
                {item.label}
              </a>
            </li>
          ))
        }
        <li class="ml-3">
          <a
            href="#contacto"
            class="glow-on-hover rounded-md bg-[var(--color-accent)] px-4 py-1.5 text-sm font-medium text-white transition-colors hover:bg-[var(--color-accent-hover)]"
          >
            Contacto
          </a>
        </li>
        <li>
          <button
            id="theme-toggle"
            type="button"
            aria-label="Alternar tema claro/oscuro"
            aria-pressed="false"
            class="ml-2 rounded-md border border-[var(--color-border)] bg-[var(--color-surface)] p-1.5 text-[var(--color-muted)] transition-colors hover:border-[var(--color-accent)]/40 hover:text-[var(--color-fg)] dark:border-[var(--color-border-dark)] dark:bg-transparent dark:text-[var(--color-muted-dark)] dark:hover:text-[var(--color-fg-dark)]"
          >
            <svg
              class="h-4 w-4 dark:hidden"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="4"></circle>
              <path
                d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
              ></path>
            </svg>
            <svg
              class="hidden h-4 w-4 dark:block"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
          </button>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;
    const root = document.documentElement;
    const sync = () => btn.setAttribute('aria-pressed', String(root.classList.contains('dark')));
    sync();
    btn.addEventListener('click', () => {
      const isDark = root.classList.toggle('dark');
      try {
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      } catch {
        /* localStorage puede fallar en modo privado */
      }
      sync();
    });
  })();
</script>
