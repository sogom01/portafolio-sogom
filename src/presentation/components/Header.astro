---
const navItems = [
  { href: '/', label: 'Inicio' },
  { href: '/about', label: 'Sobre mí' },
  { href: '/services', label: 'Servicios' },
  { href: '/projects', label: 'Proyectos' },
  { href: '/contact', label: 'Contacto' },
] as const;

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header
  role="banner"
  class="sticky top-0 z-30 border-b border-[var(--color-border)] bg-[var(--color-bg)]/80 backdrop-blur dark:border-[var(--color-border-dark)] dark:bg-[var(--color-bg-dark)]/80"
>
  <div class="mx-auto flex w-full max-w-6xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
    <a
      href="/"
      class="text-base font-semibold tracking-tight transition-colors hover:text-[var(--color-accent)]"
      aria-label="Ir a la página de inicio"
    >
      SOGOM<span class="text-[var(--color-accent)]">.</span>
    </a>

    <!-- Menú móvil: <details>/<summary> nativo, accesible sin JS. -->
    <details class="relative sm:hidden">
      <summary
        class="list-none rounded-md border border-[var(--color-border)] px-3 py-1.5 text-sm dark:border-[var(--color-border-dark)]"
        aria-label="Abrir menú de navegación"
      >
        Menú
      </summary>
      <nav
        aria-label="Principal (móvil)"
        class="absolute right-0 mt-2 w-48 rounded-md border border-[var(--color-border)] bg-[var(--color-bg)] p-2 shadow-lg dark:border-[var(--color-border-dark)] dark:bg-[var(--color-bg-dark)]"
      >
        <ul class="flex flex-col gap-1">
          {
            navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                  class:list={[
                    'block rounded px-3 py-2 text-sm',
                    isActive(item.href)
                      ? 'bg-[var(--color-accent)] text-white'
                      : 'text-[var(--color-muted)] hover:bg-[var(--color-border)] dark:hover:bg-[var(--color-border-dark)]',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>

    <!-- Navegación desktop. -->
    <nav aria-label="Principal" class="hidden sm:block">
      <ul class="flex items-center gap-1">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'rounded-md px-3 py-1.5 text-sm transition-colors',
                  isActive(item.href)
                    ? 'bg-[var(--color-accent)] text-white'
                    : 'text-[var(--color-muted)] hover:bg-[var(--color-border)] hover:text-[var(--color-fg)] dark:text-[var(--color-muted-dark)] dark:hover:bg-[var(--color-border-dark)] dark:hover:text-[var(--color-fg-dark)]',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <button
            id="theme-toggle"
            type="button"
            aria-label="Alternar tema claro/oscuro"
            aria-pressed="false"
            class="ml-2 rounded-md border border-[var(--color-border)] p-1.5 text-[var(--color-muted)] hover:text-[var(--color-fg)] dark:border-[var(--color-border-dark)] dark:text-[var(--color-muted-dark)] dark:hover:text-[var(--color-fg-dark)]"
          >
            <svg
              class="h-4 w-4 dark:hidden"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="4"></circle>
              <path
                d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
              ></path>
            </svg>
            <svg
              class="hidden h-4 w-4 dark:block"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
          </button>
        </li>
      </ul>
    </nav>
  </div>
</header>

<!-- Isla de comportamiento: solo el JS necesario para el toggle.
     `is:inline` evita bundling Vite y reduce overhead para un script de 15 líneas. -->
<script is:inline>
  (function () {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;
    const root = document.documentElement;

    const sync = () => {
      const isDark = root.classList.contains('dark');
      btn.setAttribute('aria-pressed', String(isDark));
    };
    sync();

    btn.addEventListener('click', () => {
      const isDark = root.classList.toggle('dark');
      try {
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      } catch {
        /* localStorage no disponible: el toggle sigue funcionando para esta sesión */
      }
      sync();
    });
  })();
</script>
