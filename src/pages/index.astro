---
export const prerender = true;

import BaseLayout from '../presentation/layouts/BaseLayout.astro';

const valueProps = [
  {
    title: 'Carga al instante',
    body: 'Tu web aparece antes de que el visitante pierda interés. Velocidad real, en cualquier dispositivo.',
  },
  {
    title: 'Protegida desde el primer día',
    body: 'Cuido los datos de tus visitantes como si fueran míos. Sin formularios fáciles de hackear, sin spam.',
  },
  {
    title: 'Se ve perfecta en móvil',
    body: 'La mayoría de la gente entrará desde su teléfono. Diseñada para que ese sea su mejor lugar.',
  },
  {
    title: 'Para todos, sin excepción',
    body: 'Accesible para personas con discapacidad visual, motora o cognitiva. Buena para tus usuarios y para Google.',
  },
] as const;

interface ServicePreview {
  name: string;
  price: string;
  duration: string;
  description: string;
  highlighted?: boolean;
}

const servicesPreview: readonly ServicePreview[] = [
  {
    name: 'Una página',
    price: '$1.200.000 COP',
    duration: '1–2 semanas',
    description: 'Ideal para presentar tu servicio o producto único.',
  },
  {
    name: 'Sitio completo',
    price: '$2.500.000 COP',
    duration: '2–4 semanas',
    description: 'Hasta seis páginas. Para negocios con varias áreas.',
    highlighted: true,
  },
  {
    name: 'Sitio + seguridad reforzada',
    price: '$4.200.000 COP',
    duration: '4–6 semanas',
    description: 'Cuando manejas información sensible o quieres ir un paso por delante.',
  },
];

const stats = [
  { value: '<1s', label: 'Tiempo de carga' },
  { value: '100%', label: 'Accesible en móvil' },
  { value: '24h', label: 'Tiempo de respuesta' },
  { value: '0', label: 'Costes ocultos' },
] as const;
---

<BaseLayout title="Inicio">
  <!-- ============================================================
       HERO minimalista
       ============================================================ -->
  <section aria-labelledby="hero-title" class="py-12 sm:py-20">
    <div class="max-w-4xl">
      <p
        class="fade-in-up mb-6 inline-flex items-center gap-2 rounded-full border border-[var(--color-border)] bg-white/60 px-3 py-1 text-xs font-medium tracking-wide uppercase backdrop-blur-sm dark:border-[var(--color-border-dark)] dark:bg-white/5"
      >
        <span
          class="h-1.5 w-1.5 animate-pulse rounded-full bg-[var(--color-accent)]"
          aria-hidden="true"></span>
        Aceptando nuevos proyectos
      </p>

      <h1
        id="hero-title"
        class="fade-in-up fade-in-up-delay-1 max-w-3xl text-4xl leading-[1.1] font-semibold tracking-tight text-balance sm:text-5xl lg:text-7xl"
      >
        Hago webs que
        <span class="gradient-text">venden.</span>
      </h1>

      <p
        class="fade-in-up fade-in-up-delay-2 mt-8 max-w-xl text-lg leading-relaxed text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]"
      >
        Soy Juan Sebastián, diseño y construyo sitios web cuidados al detalle. Páginas rápidas,
        seguras y agradables de usar — el tipo de web que tus clientes recuerdan.
      </p>

      <div class="fade-in-up fade-in-up-delay-3 mt-10 flex flex-col gap-3 sm:flex-row">
        <a
          href="/services"
          class="glow-on-hover inline-flex items-center justify-center rounded-md bg-[var(--color-accent)] px-7 py-3.5 text-sm font-medium text-white shadow-sm transition-colors hover:bg-[var(--color-accent-hover)]"
        >
          Ver planes y precios
          <svg
            class="ml-2 h-4 w-4 transition-transform group-hover:translate-x-0.5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </a>
        <a
          href="/contact"
          class="inline-flex items-center justify-center rounded-md px-7 py-3.5 text-sm font-medium text-[var(--color-fg)] transition-colors hover:text-[var(--color-accent)] dark:text-[var(--color-fg-dark)]"
        >
          O escríbeme directamente →
        </a>
      </div>
    </div>
  </section>

  <!-- ============================================================
       STATS — números en lenguaje claro
       ============================================================ -->
  <section
    aria-labelledby="stats-title"
    class="border-y border-[var(--color-border)] py-10 dark:border-[var(--color-border-dark)]"
  >
    <h2 id="stats-title" class="sr-only">Lo que recibes</h2>
    <div class="grid grid-cols-2 gap-8 sm:grid-cols-4">
      {
        stats.map((s, i) => (
          <div class={`reveal reveal-delay-${Math.min(i, 3)}`}>
            <p class="text-4xl font-semibold tracking-tight sm:text-5xl">
              <span class="gradient-text">{s.value}</span>
            </p>
            <p class="mt-3 text-xs tracking-wide text-[var(--color-muted)] uppercase dark:text-[var(--color-muted-dark)]">
              {s.label}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ============================================================
       VALUE PROPS — beneficios en lenguaje claro
       ============================================================ -->
  <section
    aria-labelledby="value-title"
    class="border-b border-[var(--color-border)] py-16 sm:py-20 dark:border-[var(--color-border-dark)]"
  >
    <div class="reveal max-w-2xl">
      <p class="mb-4 text-xs font-medium tracking-wider text-[var(--color-accent)] uppercase">
        Por qué trabajar conmigo
      </p>
      <h2 id="value-title" class="text-3xl font-semibold tracking-tight sm:text-4xl">
        Cuatro cosas que recibes <span class="gradient-text">siempre.</span>
      </h2>
      <p class="mt-4 text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]">
        Sin importar el tamaño del proyecto, todas mis webs cumplen lo mismo.
      </p>
    </div>

    <ul class="mt-14 grid grid-cols-1 gap-8 sm:grid-cols-2">
      {
        valueProps.map((v, i) => (
          <li class={`reveal reveal-delay-${Math.min(i, 3)} flex gap-5`}>
            <span
              class="mt-1 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-[var(--color-accent)] to-[var(--color-accent-2)] text-sm font-semibold text-white"
              aria-hidden="true"
            >
              {String(i + 1).padStart(2, '0')}
            </span>
            <div>
              <h3 class="text-lg font-semibold">{v.title}</h3>
              <p class="mt-2 text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]">
                {v.body}
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ============================================================
       SERVICES PREVIEW — claro y minimal
       ============================================================ -->
  <section
    aria-labelledby="services-preview-title"
    class="border-b border-[var(--color-border)] py-16 sm:py-20 dark:border-[var(--color-border-dark)]"
  >
    <div class="reveal flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-xl">
        <p class="mb-4 text-xs font-medium tracking-wider text-[var(--color-accent)] uppercase">
          Cómo trabajamos
        </p>
        <h2 id="services-preview-title" class="text-3xl font-semibold tracking-tight sm:text-4xl">
          Tres planes <span class="gradient-text">claros y honestos.</span>
        </h2>
        <p class="mt-4 text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]">
          Precios sin sorpresas, en pesos colombianos.
        </p>
      </div>
      <a
        href="/services"
        class="group inline-flex items-center text-sm font-medium text-[var(--color-accent)]"
      >
        Ver el detalle completo
        <svg
          class="ml-1 h-4 w-4 transition-transform group-hover:translate-x-1"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6"></path>
        </svg>
      </a>
    </div>

    <ul class="mt-14 grid grid-cols-1 gap-4 md:grid-cols-3">
      {
        servicesPreview.map((s, i) => (
          <li
            class:list={[
              `reveal reveal-delay-${Math.min(i, 3)} lift rounded-2xl border bg-[var(--color-bg)] p-7 dark:bg-[var(--color-bg-dark)]`,
              s.highlighted
                ? 'border-[var(--color-accent)]'
                : 'border-[var(--color-border)] dark:border-[var(--color-border-dark)]',
            ]}
          >
            {s.highlighted && (
              <p class="mb-4 inline-block w-fit rounded-full bg-gradient-to-r from-[var(--color-accent)] to-[var(--color-accent-2)] px-3 py-0.5 text-xs font-semibold text-white">
                Más solicitado
              </p>
            )}
            <h3 class="text-lg font-semibold">{s.name}</h3>
            <p class="mt-2 text-sm text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]">
              {s.description}
            </p>
            <p class="mt-6 text-2xl font-semibold tracking-tight">{s.price}</p>
            <p class="mt-1 text-xs tracking-wide text-[var(--color-muted)] uppercase dark:text-[var(--color-muted-dark)]">
              Entrega en {s.duration}
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ============================================================
       FINAL CTA — elegante, gradient suave
       ============================================================ -->
  <section class="py-16 sm:py-20">
    <div
      class="reveal relative isolate overflow-hidden rounded-3xl bg-gradient-to-br from-[var(--color-accent)] to-[var(--color-accent-2)] p-10 text-white sm:p-16"
    >
      <div
        class="absolute inset-0 bg-[radial-gradient(circle_at_30%_20%,rgba(255,255,255,0.15),transparent_60%)]"
        aria-hidden="true"
      >
      </div>
      <div class="relative max-w-2xl">
        <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl lg:text-5xl">
          Cuéntame tu idea.
        </h2>
        <p class="mt-4 text-lg text-white/90">
          Te respondo en menos de 24 horas con una propuesta clara y sin compromiso.
        </p>
        <a
          href="/contact"
          class="mt-8 inline-flex items-center justify-center rounded-md bg-white px-7 py-3.5 text-sm font-semibold text-[var(--color-accent)] shadow-lg transition-transform hover:scale-105"
        >
          Empezar conversación
          <svg
            class="ml-2 h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
