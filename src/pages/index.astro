---
export const prerender = true;

import BaseLayout from '../presentation/layouts/BaseLayout.astro';

const valueProps = [
  {
    title: 'Rápido por diseño',
    body: 'Astro + render estático. Lighthouse Performance ≥ 95 sin esfuerzo.',
    icon: '⚡',
  },
  {
    title: 'Seguro por defecto',
    body: 'OWASP Top 10 aplicado desde el primer commit. Headers, validación, anti-bot.',
    icon: '🛡',
  },
  {
    title: 'Accesible para todos',
    body: 'WCAG AA cumplido. Navegable por teclado, lector de pantalla y modo oscuro.',
    icon: '🦮',
  },
  {
    title: 'Mantenible',
    body: 'TypeScript estricto, tests automáticos y CI/CD verde antes de cada deploy.',
    icon: '🧪',
  },
] as const;

interface ServicePreview {
  name: string;
  price: string;
  duration: string;
  highlighted?: boolean;
}

const servicesPreview: readonly ServicePreview[] = [
  {
    name: 'Landing Profesional',
    price: '$1.200.000 COP / $290 USD',
    duration: '1–2 semanas',
  },
  {
    name: 'Sitio Multipágina',
    price: '$2.500.000 COP / $590 USD',
    duration: '2–4 semanas',
    highlighted: true,
  },
  {
    name: 'Web + Auditoría Seguridad',
    price: '$4.200.000 COP / $990 USD',
    duration: '4–6 semanas',
  },
];

const stats = [
  { value: '95+', label: 'Lighthouse Performance' },
  { value: '100', label: 'Accesibilidad WCAG AA' },
  { value: '30', label: 'Tests automáticos' },
  { value: '4', label: 'Capas anti-spam' },
] as const;

const techStack = [
  'Astro',
  'TypeScript',
  'Tailwind CSS',
  'Python',
  'PostgreSQL',
  'Node.js',
  'Vercel',
  'GitHub Actions',
  'OWASP Top 10',
  'Zod',
  'Vitest',
  'Cloudflare',
];
---

<BaseLayout title="Inicio">
  <!-- ============================================================
       HERO con blobs animados y mini-terminal
       ============================================================ -->
  <section aria-labelledby="hero-title" class="relative isolate overflow-hidden py-16 sm:py-24">
    <!-- Blobs de fondo decorativos. -->
    <div class="blob blob-blue top-[-100px] left-[-80px] h-[280px] w-[280px]" aria-hidden="true">
    </div>
    <div class="blob blob-purple top-[60px] right-[-60px] h-[320px] w-[320px]" aria-hidden="true">
    </div>

    <div class="relative z-10 grid grid-cols-1 items-center gap-10 lg:grid-cols-5">
      <!-- Texto del hero. -->
      <div class="lg:col-span-3">
        <p
          class="fade-in-up mb-4 inline-flex items-center gap-2 rounded-full border border-[var(--color-border)] bg-white/50 px-3 py-1 text-xs font-medium tracking-wide uppercase backdrop-blur-sm dark:border-[var(--color-border-dark)] dark:bg-white/5"
        >
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-500"></span>
          Disponible para nuevos proyectos
        </p>

        <h1
          id="hero-title"
          class="fade-in-up fade-in-up-delay-1 max-w-3xl text-4xl font-bold tracking-tight text-balance sm:text-5xl lg:text-6xl"
        >
          Web rápida, accesible y
          <span class="gradient-text">endurecida desde el primer commit.</span>
        </h1>

        <p
          class="fade-in-up fade-in-up-delay-2 mt-6 max-w-2xl text-lg leading-relaxed text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]"
        >
          Soy <strong class="text-[var(--color-fg)] dark:text-[var(--color-fg-dark)]"
            >Juan Sebastián</strong
          >, desarrollador web colombiano y estudiante de seguridad. Diseño sitios que venden, con
          estándares OWASP aplicados desde el código.
        </p>

        <div class="fade-in-up fade-in-up-delay-3 mt-8 flex flex-col gap-3 sm:flex-row">
          <a
            href="/services"
            class="glow-on-hover inline-flex items-center justify-center rounded-md bg-[var(--color-accent)] px-6 py-3 text-sm font-medium text-white shadow-sm transition-colors hover:bg-[var(--color-accent-hover)]"
          >
            Ver servicios y precios
            <svg
              class="ml-1.5 h-4 w-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6"></path>
            </svg>
          </a>
          <a
            href="/contact"
            class="inline-flex items-center justify-center rounded-md border border-[var(--color-border)] bg-white/50 px-6 py-3 text-sm font-medium text-[var(--color-fg)] backdrop-blur-sm transition-colors hover:bg-[var(--color-border)] dark:border-[var(--color-border-dark)] dark:bg-white/5 dark:text-[var(--color-fg-dark)] dark:hover:bg-[var(--color-border-dark)]"
          >
            Hablemos de tu proyecto
          </a>
        </div>
      </div>

      <!-- Mini-terminal con código de validación de seguridad. -->
      <div class="fade-in-up fade-in-up-delay-2 lg:col-span-2">
        <div
          class="gradient-border overflow-hidden rounded-xl bg-[var(--color-bg)]/80 shadow-2xl backdrop-blur-sm dark:bg-[var(--color-bg-dark)]/80"
        >
          <!-- Barra superior estilo terminal. -->
          <div
            class="flex items-center gap-1.5 border-b border-[var(--color-border)] px-4 py-2.5 dark:border-[var(--color-border-dark)]"
          >
            <span class="h-2.5 w-2.5 rounded-full bg-red-400" aria-hidden="true"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-yellow-400" aria-hidden="true"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-green-400" aria-hidden="true"></span>
            <span
              class="ml-3 text-xs text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]"
            >
              contact.ts — secured by design
            </span>
          </div>

          <!-- Código. -->
          <pre
            class="overflow-x-auto p-4 text-xs leading-relaxed"
            style="font-family: var(--font-mono);"><code><span class="text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]">// 4 capas de defensa anti-spam</span>
<span class="text-[var(--color-accent)]">const</span> result = <span class="text-[var(--color-accent)]">await</span> validate(payload);

<span class="text-[var(--color-accent-2)]">✓</span> rateLimit(<span class="text-green-600 dark:text-green-400">'5/min'</span>)
<span class="text-[var(--color-accent-2)]">✓</span> originCheck(<span class="text-green-600 dark:text-green-400">'same-origin'</span>)
<span class="text-[var(--color-accent-2)]">✓</span> zodSchema.parse(input)
<span class="text-[var(--color-accent-2)]">✓</span> turnstile.verify(token)
<span class="text-[var(--color-accent-2)]">✓</span> sanitize(message)

<span class="text-green-600 dark:text-green-400">→ resend.send(safe)</span><span class="terminal-cursor" /></code></pre>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       MARQUEE de tech stack
       ============================================================ -->
  <section
    aria-label="Tecnologías que utilizo"
    class="border-y border-[var(--color-border)] bg-[var(--color-bg)] py-6 dark:border-[var(--color-border-dark)] dark:bg-transparent"
  >
    <div class="marquee">
      <div class="marquee__track">
        {
          [...techStack, ...techStack].map((t) => (
            <span class="flex items-center gap-2 text-sm font-medium text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]">
              <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-accent)]" aria-hidden="true" />
              {t}
            </span>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============================================================
       STATS
       ============================================================ -->
  <section
    aria-labelledby="stats-title"
    class="border-b border-[var(--color-border)] py-16 dark:border-[var(--color-border-dark)]"
  >
    <h2 id="stats-title" class="sr-only">Métricas del proyecto</h2>
    <div class="grid grid-cols-2 gap-8 sm:grid-cols-4">
      {
        stats.map((s, i) => (
          <div class={`reveal reveal-delay-${Math.min(i, 3)} text-center sm:text-left`}>
            <p class="text-4xl font-bold tracking-tight sm:text-5xl">
              <span class="gradient-text">{s.value}</span>
            </p>
            <p class="mt-2 text-xs tracking-wide text-[var(--color-muted)] uppercase dark:text-[var(--color-muted-dark)]">
              {s.label}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ============================================================
       VALUE PROPS con hover lift
       ============================================================ -->
  <section
    aria-labelledby="value-title"
    class="border-b border-[var(--color-border)] py-16 sm:py-20 dark:border-[var(--color-border-dark)]"
  >
    <div class="reveal">
      <h2 id="value-title" class="text-3xl font-semibold tracking-tight sm:text-4xl">
        Lo que diferencia mi trabajo
      </h2>
      <p class="mt-3 max-w-2xl text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]">
        Cuatro principios no negociables que aplico a cada proyecto.
      </p>
    </div>

    <ul class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        valueProps.map((v, i) => (
          <li
            class={`reveal reveal-delay-${Math.min(i, 3)} lift group rounded-xl border border-[var(--color-border)] bg-[var(--color-bg)] p-6 dark:border-[var(--color-border-dark)] dark:bg-[var(--color-bg-dark)]`}
          >
            <span
              class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-gradient-to-br from-[var(--color-accent)]/10 to-[var(--color-accent-2)]/10 text-2xl transition-transform group-hover:scale-110"
              aria-hidden="true"
            >
              {v.icon}
            </span>
            <h3 class="mt-4 font-semibold">{v.title}</h3>
            <p class="mt-2 text-sm text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]">
              {v.body}
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ============================================================
       SERVICES PREVIEW
       ============================================================ -->
  <section
    aria-labelledby="services-preview-title"
    class="border-b border-[var(--color-border)] py-16 sm:py-20 dark:border-[var(--color-border-dark)]"
  >
    <div class="reveal flex flex-wrap items-end justify-between gap-3">
      <div>
        <h2 id="services-preview-title" class="text-3xl font-semibold tracking-tight sm:text-4xl">
          Tres formas de trabajar conmigo
        </h2>
        <p class="mt-3 max-w-2xl text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]">
          Precios transparentes en pesos colombianos y dólares.
        </p>
      </div>
      <a
        href="/services"
        class="group inline-flex items-center text-sm font-medium text-[var(--color-accent)]"
      >
        Ver todos los detalles
        <svg
          class="ml-1 h-4 w-4 transition-transform group-hover:translate-x-1"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6"></path>
        </svg>
      </a>
    </div>

    <ul class="mt-10 grid grid-cols-1 gap-4 md:grid-cols-3">
      {
        servicesPreview.map((s, i) => (
          <li
            class:list={[
              `reveal reveal-delay-${Math.min(i, 3)} lift rounded-xl border p-6`,
              s.highlighted
                ? 'border-[var(--color-accent)] bg-gradient-to-br from-[var(--color-accent)]/5 to-[var(--color-accent-2)]/5 ring-1 ring-[var(--color-accent)]'
                : 'border-[var(--color-border)] dark:border-[var(--color-border-dark)]',
            ]}
          >
            {s.highlighted && (
              <p class="mb-3 inline-block w-fit rounded-full bg-gradient-to-r from-[var(--color-accent)] to-[var(--color-accent-2)] px-3 py-0.5 text-xs font-semibold text-white">
                Más popular
              </p>
            )}
            <h3 class="font-semibold">{s.name}</h3>
            <p class="mt-2 text-xl font-bold tracking-tight">{s.price}</p>
            <p class="mt-1 text-xs tracking-wide text-[var(--color-muted)] uppercase dark:text-[var(--color-muted-dark)]">
              {s.duration}
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ============================================================
       FINAL CTA con gradiente
       ============================================================ -->
  <section class="py-16 sm:py-20">
    <div
      class="reveal relative isolate overflow-hidden rounded-2xl bg-gradient-to-br from-[var(--color-accent)] via-[var(--color-accent)] to-[var(--color-accent-2)] p-8 text-white sm:p-12"
    >
      <!-- Patrón decorativo de fondo. -->
      <div
        class="absolute inset-0 bg-[radial-gradient(circle_at_30%_20%,rgba(255,255,255,0.15),transparent_50%)]"
        aria-hidden="true"
      >
      </div>
      <div class="relative">
        <h2 class="max-w-2xl text-3xl font-bold tracking-tight sm:text-4xl">
          ¿Listo para arrancar tu próximo sitio?
        </h2>
        <p class="mt-3 max-w-2xl text-white/90">
          Cuéntame qué necesitas. Respondo en menos de 48 horas con una propuesta clara, sin
          compromisos ni costes ocultos.
        </p>
        <a
          href="/contact"
          class="mt-6 inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-sm font-semibold text-[var(--color-accent)] shadow-lg transition-transform hover:scale-105"
        >
          Iniciar conversación
          <svg
            class="ml-1.5 h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
