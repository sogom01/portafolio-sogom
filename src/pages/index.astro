---
export const prerender = true;

import BaseLayout from '../presentation/layouts/BaseLayout.astro';

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';

/* ── Iconos de tecnología ───────────────────────────────────── */
type TechIcon = { slug: string; color?: string; invertDark?: boolean };
const techIconMap = new Map<string, TechIcon>([
  ['Astro', { slug: 'astro', color: 'FF5D01' }],
  ['TypeScript', { slug: 'typescript', color: '3178C6' }],
  ['Tailwind CSS', { slug: 'tailwindcss', color: '06B6D4' }],
  ['Tailwind', { slug: 'tailwindcss', color: '06B6D4' }],
  ['Supabase', { slug: 'supabase', color: '3ECF8E' }],
  ['Zod', { slug: 'zod', color: '3E67B1' }],
  ['Vercel', { slug: 'vercel', invertDark: true }],
  ['Next.js', { slug: 'nextdotjs', invertDark: true }],
  ['HTML', { slug: 'html5', color: 'E34F26' }],
  ['JavaScript', { slug: 'javascript', color: 'F7DF1E' }],
  ['Prisma', { slug: 'prisma', invertDark: true }],
  ['PostgreSQL', { slug: 'postgresql', color: '4169E1' }],
  ['Cloudflare', { slug: 'cloudflare', color: 'F6821F' }],
  ['Resend', { slug: 'resend', invertDark: true }],
]);

/* ── Proyectos ──────────────────────────────────────────────── */
interface Project {
  name: string;
  category: string;
  tagline: string;
  stack: readonly string[];
  liveUrl?: string;
  repoUrl?: string;
  previewImage?: string;
  imageGradient: string;
  palette: readonly string[];
  status?: 'building';
}

const projects: readonly Project[] = [
  {
    name: 'SIEMLogs',
    category: 'Ciberseguridad · Monitoreo',
    tagline: 'Visibilidad total sobre tus incidentes.',
    stack: ['Astro', 'TypeScript', 'Tailwind CSS', 'Vercel'],
    imageGradient: 'linear-gradient(135deg,#0A0A0F 0%,#1A1A2E 50%,#6C63FF 100%)',
    palette: ['#0A0A0F', '#6C63FF', '#F5F5FF', '#1A1A2E'],
    liveUrl: 'https://gestor-siem.vercel.app/',
    repoUrl: 'https://github.com/sogom01/gestor-siem',
    previewImage: '/projects/gestor-siem.preview.webp',
    status: 'building',
  },
  {
    name: 'Pulso',
    category: 'Estudio creativo · Marketing',
    tagline: 'Marcas que la gente recuerda.',
    stack: ['HTML', 'Tailwind CSS', 'JavaScript'],
    imageGradient: 'linear-gradient(135deg,#F2F0EA 0%,#2A2BF5 60%,#14130F 100%)',
    palette: ['#F2F0EA', '#2A2BF5', '#14130F', '#FBFAF6'],
    liveUrl: 'https://marketing-agency-pulso.vercel.app/',
    repoUrl: 'https://github.com/sogom01/Marketing-Agency',
    previewImage: '/projects/marketing-agency-pulso.preview.webp',
  },
  {
    name: 'Café Señor Martin',
    category: 'Café de origen · Gastronomía',
    tagline: 'Donde la montaña se vuelve tinto.',
    stack: ['HTML', 'Tailwind CSS', 'JavaScript'],
    imageGradient: 'linear-gradient(135deg,#F3EAD9 0%,#B85C38 50%,#2A1E16 100%)',
    palette: ['#F3EAD9', '#B85C38', '#2A1E16', '#E7A879'],
    liveUrl: 'https://cafe-senor-martin.vercel.app/',
    repoUrl: 'https://github.com/sogom01/cafe-san-martin',
    previewImage: '/projects/señor-martin.preview.webp',
  },
  {
    name: 'Marfil',
    category: 'Clínica dental · Salud',
    tagline: 'Sonríe con total confianza.',
    stack: ['Astro', 'TypeScript', 'Tailwind CSS', 'Supabase', 'Zod', 'Vercel'],
    imageGradient: 'linear-gradient(135deg,#EEF5F7 0%,#15B5AE 70%,#0E3A47 100%)',
    palette: ['#EEF5F7', '#15B5AE', '#0E3A47', '#D7EFEC'],
    liveUrl: 'https://marfil-dental.vercel.app',
    repoUrl: 'https://github.com/sogom01/marfil-dental',
    previewImage: '/projects/marfil-preview.webp',
  },
  {
    name: 'FORJA',
    category: 'Fitness · Gimnasio',
    tagline: 'Tu mejor versión se forja aquí.',
    stack: ['HTML', 'Tailwind CSS', 'JavaScript'],
    imageGradient: 'linear-gradient(135deg,#0B0C0E 0%,#191C21 60%,#CCFF00 100%)',
    palette: ['#0B0C0E', '#CCFF00', '#191C21', '#F4F6F4'],
    liveUrl: 'https://forja-gym.vercel.app/',
    repoUrl: 'https://github.com/sogom01/forja-gym',
    previewImage: '/projects/forja-gym.preview.webp',
  },
  {
    name: 'Pan y Ricuras',
    category: 'Carta digital · Panadería',
    tagline: 'Bienvenido — explora nuestra carta.',
    stack: ['Next.js', 'TypeScript', 'Tailwind CSS', 'Supabase', 'Zod', 'Vercel'],
    imageGradient: 'linear-gradient(135deg,#1a0f07 0%,#2e1c0a 50%,#c99e4c 100%)',
    palette: ['#1a0f07', '#c99e4c', '#f5ead8', '#4a7c59'],
    liveUrl: 'https://pan-y-ricuras-chipre.vercel.app/',
    repoUrl: 'https://github.com/sogom01/pan-y-ricuras-chipre',
    previewImage: '/projects/pan-y-ricuras-preview.webp',
  },
  {
    name: 'Motor Store',
    category: 'E-commerce · Repuestos de moto',
    tagline: 'Todo lo que tu moto necesita.',
    stack: ['Next.js', 'TypeScript', 'Tailwind CSS', 'Supabase', 'Zod', 'Vercel'],
    imageGradient: 'linear-gradient(135deg,#030000 0%,#9f1239 60%,#e11d48 100%)',
    palette: ['#030000', '#9f1239', '#e11d48', '#f43f5e'],
    liveUrl: 'https://motorstore.vercel.app/',
    repoUrl: 'https://github.com/sogom01/motor-store',
    previewImage: '/projects/motorstore-preview.webp',
  },
  {
    name: 'Teclook',
    category: 'Agencia · Marketing & Software',
    tagline: 'Tecnología con mirada estratégica.',
    stack: ['Astro', 'TypeScript', 'Tailwind CSS', 'Vercel'],
    imageGradient: 'linear-gradient(135deg,#0A0A0F 0%,#1A1A2E 50%,#6C63FF 100%)',
    palette: ['#0A0A0F', '#6C63FF', '#F5F5FF', '#1A1A2E'],
    liveUrl: 'https://teclook.vercel.app/',
    repoUrl: 'https://github.com/sogom01/teclook',
    previewImage: '/projects/tecklook.preview.webp',
    status: 'building',
  },
];

/* ── Servicios ──────────────────────────────────────────────── */
const services = [
  {
    no: '01',
    name: 'Una página',
    price: '$1.200.000',
    duration: '1–2 sem.',
    desc: 'Lo esencial para existir en internet. Responsive, rápida y lista para Google.',
  },
  {
    no: '02',
    name: 'Sitio completo',
    price: '$2.500.000',
    duration: '2–4 sem.',
    desc: 'Hasta seis páginas con identidad propia, blog y modo claro/oscuro.',
    highlight: true,
  },
  {
    no: '03',
    name: 'Con seguridad reforzada',
    price: '$4.200.000',
    duration: '4–6 sem.',
    desc: 'Auditoría OWASP documentada, reporte ejecutivo y acompañamiento post-entrega.',
  },
] satisfies {
  no: string;
  name: string;
  price: string;
  duration: string;
  desc: string;
  highlight?: boolean;
}[];

/* ── Principios ─────────────────────────────────────────────── */
const principles = [
  { title: 'Seguridad desde el día uno', body: 'Cada formulario, cada cabecera HTTP. Sin atajos.' },
  { title: 'Rápida o no se entrega', body: 'Una web lenta es una web perdida. Carga en < 1 s.' },
  {
    title: 'Todo queda explicado',
    body: 'Te entrego documentación clara. Sin dependencias eternas.',
  },
  { title: 'Honestidad por delante', body: 'Si algo está fuera de mi alcance, te lo digo.' },
] as const;

/* ── Marquee de tecnologías ─────────────────────────────────── */
type MarqueeItem = { name: string; slug?: string; color?: string; invertDark?: boolean };
const marqueeItems: MarqueeItem[] = [
  { name: 'HTML · CSS', slug: 'html5', color: 'E34F26' },
  { name: 'JavaScript', slug: 'javascript', color: 'F7DF1E' },
  { name: 'TypeScript', slug: 'typescript', color: '3178C6' },
  { name: 'React', slug: 'react', color: '61DAFB' },
  { name: 'Astro', slug: 'astro', color: 'FF5D01' },
  { name: 'Next.js', slug: 'nextdotjs', invertDark: true },
  { name: 'Tailwind CSS', slug: 'tailwindcss', color: '06B6D4' },
  { name: 'Supabase', slug: 'supabase', color: '3ECF8E' },
  { name: 'PostgreSQL', slug: 'postgresql', color: '4169E1' },
  { name: 'Git', slug: 'git', color: 'F05032' },
  { name: 'Vercel', slug: 'vercel', invertDark: true },
  { name: 'Node.js', slug: 'nodedotjs', color: '5FA04E' },
  { name: 'Zod', slug: 'zod', color: '3E67B1' },
  { name: 'Prisma', slug: 'prisma', invertDark: true },
  { name: 'Cloudflare', slug: 'cloudflare', color: 'F6821F' },
  { name: 'OWASP' },
  { name: 'Accesibilidad' },
];
---

<BaseLayout title="Inicio">
  <!-- ═══════════════════════════════════════════════════════════
       HERO — con grid de fondo y scroll indicator
  ════════════════════════════════════════════════════════════ -->
  <section
    id="inicio"
    aria-labelledby="hero-title"
    class="hero-grid relative flex min-h-[calc(100svh-3.5rem)] flex-col pt-6 sm:pt-8"
  >
    <div
      class="relative z-10 grid grid-cols-1 items-start gap-10 pb-10 lg:grid-cols-[1fr_300px] lg:gap-14"
    >
      <!-- Columna izquierda: texto principal -->
      <div>
        <!-- Badge de disponibilidad -->
        <div
          class="fade-in-up mb-5 inline-flex items-center gap-2.5 rounded-full border border-[var(--color-border)] bg-[var(--color-surface)] px-4 py-1.5 dark:border-[var(--color-border-dark)] dark:bg-[var(--color-surface-dark)]"
        >
          <span
            class="inline-block h-2 w-2 rounded-full bg-[var(--color-accent)] shadow-[0_0_6px_var(--color-accent)]"
            style="animation:pulse-dot 2s infinite"></span>
          <span
            class="font-mono text-[11px] font-medium tracking-wider text-[var(--color-muted)] uppercase dark:text-[var(--color-muted-dark)]"
          >
            Disponible para nuevos proyectos
          </span>
        </div>

        <h1
          id="hero-title"
          class="fade-in-up fade-in-up-delay-1 text-5xl leading-[1.05] font-semibold tracking-tight text-balance sm:text-6xl lg:text-6xl"
        >
          Desarrollador web.<br />
          <span class="text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]">
            Construyo sitios que funcionan.
          </span>
        </h1>

        <p
          class="fade-in-up fade-in-up-delay-2 mt-5 max-w-lg text-base leading-relaxed text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]"
        >
          Soy Juan Sebastián. Sitios rápidos, seguros y a la medida — el tipo de web del que tus
          clientes hablan después de cerrar el navegador.
        </p>

        <div class="fade-in-up fade-in-up-delay-3 mt-6 flex flex-wrap gap-3">
          <a
            href="#proyectos"
            class="glow-on-hover inline-flex items-center justify-center rounded-md bg-[var(--color-accent)] px-7 py-3.5 text-sm font-medium text-white shadow-sm transition-colors hover:bg-[var(--color-accent-hover)]"
          >
            Ver proyectos →
          </a>
          <a
            href="#contacto"
            class="inline-flex items-center justify-center rounded-md border border-[var(--color-border)] bg-[var(--color-surface)] px-7 py-3.5 text-sm font-medium text-[var(--color-fg)] transition-colors hover:border-[var(--color-accent)]/60 hover:bg-[var(--color-surface)] dark:border-[var(--color-border-dark)] dark:bg-transparent dark:text-[var(--color-fg-dark)]"
          >
            Hablemos
          </a>
        </div>
      </div>

      <!-- Columna derecha: propuesta de valor (solo desktop) -->
      <div class="fade-in-up fade-in-up-delay-3 hidden lg:block">
        <div
          class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-6 dark:border-[var(--color-border-dark)] dark:bg-[var(--color-surface-dark)]"
        >
          <p class="mb-5 font-mono text-[11px] tracking-wider text-[var(--color-accent)] uppercase">
            // Lo que incluye
          </p>
          <ul class="divide-y divide-[var(--color-border)] dark:divide-[var(--color-border-dark)]">
            {
              [
                { icon: '⚡', text: 'Entrega en 1–4 semanas', sub: 'Sin plazos eternos' },
                { icon: '🔒', text: 'Seguridad OWASP', sub: 'Desde el primer commit' },
                { icon: '📱', text: '100% responsive', sub: 'Mobile, tablet y desktop' },
                { icon: '💬', text: 'Soporte post-entrega', sub: 'No desaparezco al subir' },
              ].map((item) => (
                <li class="flex items-center gap-3 py-3 first:pt-0 last:pb-0">
                  <span class="text-lg leading-none" aria-hidden="true">
                    {item.icon}
                  </span>
                  <div>
                    <p class="text-sm font-medium text-[var(--color-fg)] dark:text-[var(--color-fg-dark)]">
                      {item.text}
                    </p>
                    <p class="text-xs text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]">
                      {item.sub}
                    </p>
                  </div>
                </li>
              ))
            }
          </ul>
          <a
            href="#servicios"
            class="mt-3 block text-right font-mono text-[11px] tracking-wider text-[var(--color-muted)] uppercase transition-colors hover:text-[var(--color-accent)] dark:text-[var(--color-muted-dark)]"
          >
            Ver servicios →
          </a>
        </div>
      </div>
    </div>

    <!-- Marquee + chevron agrupados al fondo del hero -->
    <div class="mt-4">
      <!-- Banda de tecnologías -->
      <div
        class="-mx-4 overflow-hidden border-y border-[var(--color-border)] py-3 sm:-mx-6 lg:-mx-8 dark:border-[var(--color-border-dark)]"
        aria-hidden="true"
      >
        <div class="marquee-track">
          {
            [...marqueeItems, ...marqueeItems].map((item) => (
              <span class="mx-5 inline-flex items-center gap-2 whitespace-nowrap">
                {item.slug && (
                  <img
                    src={`https://cdn.simpleicons.org/${item.slug}${item.color ? '/' + item.color : ''}`}
                    alt=""
                    width="14"
                    height="14"
                    class:list={['h-3.5 w-3.5 shrink-0', { 'dark:invert': item.invertDark }]}
                    loading="lazy"
                  />
                )}
                <span class="font-mono text-xs text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]">
                  {item.name}
                </span>
              </span>
            ))
          }
        </div>
      </div>
      <!-- Scroll indicator -->
      <div class="relative z-10 flex justify-center py-2" aria-hidden="true">
        <a
          href="#proyectos"
          class="bounce-chevron text-[var(--color-muted)]/50 dark:text-[var(--color-muted-dark)]/50"
        >
          <svg
            class="h-5 w-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="m19 9-7 7-7-7"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       PROYECTOS — grid 3 col con grayscale hover
  ════════════════════════════════════════════════════════════ -->
  <section
    id="proyectos"
    aria-labelledby="projects-title"
    class="border-t border-[var(--color-border)] py-20 dark:border-[var(--color-border-dark)]"
  >
    <div class="reveal mb-12 flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="mb-3 font-mono text-xs tracking-wider text-[var(--color-accent)] uppercase">
          // 01 — Proyectos
        </p>
        <h2 id="projects-title" class="text-3xl font-semibold tracking-tight sm:text-4xl">
          Trabajos <span class="italic-accent">reales</span>.
        </h2>
      </div>
      <a
        href="/projects"
        class="group inline-flex items-center gap-1 text-sm font-medium text-[var(--color-accent)]"
      >
        Ver todos
        <svg
          class="h-4 w-4 transition-transform group-hover:translate-x-1"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6"></path>
        </svg>
      </a>
    </div>

    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        projects.map((p, i) => (
          <article
            class={`reveal reveal-delay-${Math.min(i, 3)} group relative overflow-hidden rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] transition-all duration-300 hover:-translate-y-1 hover:border-[var(--color-accent)]/50 hover:shadow-[var(--color-accent)]/5 hover:shadow-lg dark:border-[var(--color-border-dark)] dark:bg-[var(--color-bg-dark)]`}
          >
            {/* Stretched link */}
            {(p.liveUrl || p.repoUrl) && (
              <a
                href={p.liveUrl ?? p.repoUrl ?? '#'}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Visitar ${p.name}`}
                class="absolute inset-0 z-10"
              />
            )}

            {/* Miniatura */}
            {p.previewImage ? (
              <div class="relative h-44 overflow-hidden">
                <img
                  src={p.previewImage}
                  alt={`Vista previa de ${p.name}`}
                  class="h-full w-full object-cover object-top [filter:grayscale(1)_brightness(0.7)] transition-all duration-700 group-hover:scale-105 group-hover:[filter:grayscale(0)_brightness(0.95)]"
                  loading="lazy"
                />
                <div class="absolute inset-0 flex items-center justify-center bg-black/0 transition-colors duration-300 group-hover:bg-black/30">
                  <span class="flex translate-y-2 items-center gap-1.5 rounded-full bg-white/90 px-3 py-1 text-xs font-semibold text-gray-900 opacity-0 shadow-lg backdrop-blur-sm transition-all duration-300 group-hover:translate-y-0 group-hover:opacity-100">
                    Ver proyecto ↗
                  </span>
                </div>
                {p.status === 'building' && (
                  <div class="absolute top-2.5 left-2.5">
                    <span class="inline-flex rounded-full bg-gradient-to-r from-[var(--color-accent)] to-[var(--color-accent-2)] px-2.5 py-0.5 text-[10px] font-semibold text-white uppercase shadow-sm backdrop-blur-sm">
                      En desarrollo
                    </span>
                  </div>
                )}
              </div>
            ) : (
              <div
                class="relative h-44 overflow-hidden"
                style={`background:${p.imageGradient}`}
                aria-hidden="true"
              >
                <div class="absolute inset-0 flex items-center justify-center bg-black/0 transition-colors duration-300 group-hover:bg-black/20">
                  <span class="flex translate-y-2 items-center gap-1.5 rounded-full bg-white/90 px-3 py-1 text-xs font-semibold text-gray-900 opacity-0 shadow-lg backdrop-blur-sm transition-all duration-300 group-hover:translate-y-0 group-hover:opacity-100">
                    Próximamente
                  </span>
                </div>
                <div class="absolute right-3 bottom-3 flex gap-1.5">
                  {p.palette.map((c) => (
                    <span
                      class="h-4 w-4 rounded-full border border-white/40"
                      style={`background:${c}`}
                    />
                  ))}
                </div>
                {p.status === 'building' && (
                  <div class="absolute top-2.5 left-2.5">
                    <span class="inline-flex rounded-full bg-gradient-to-r from-[var(--color-accent)] to-[var(--color-accent-2)] px-2.5 py-0.5 text-[10px] font-semibold text-white uppercase shadow-sm">
                      En desarrollo
                    </span>
                  </div>
                )}
              </div>
            )}

            {/* Cuerpo */}
            <div class="p-5">
              <p class="font-mono text-[10px] tracking-wider text-[var(--color-muted)] uppercase dark:text-[var(--color-muted-dark)]">
                {p.category}
              </p>
              <h3 class="mt-1.5 text-base font-semibold tracking-tight">{p.name}</h3>
              <p class="mt-1 font-serif text-xs text-[var(--color-accent)] italic">"{p.tagline}"</p>

              <div class="relative z-20 mt-4 flex items-center justify-between">
                <ul class="flex flex-wrap gap-2">
                  {p.stack.slice(0, 4).map((s) => {
                    const tech = techIconMap.get(s);
                    const src = tech
                      ? `https://cdn.simpleicons.org/${tech.slug}${tech.color ? '/' + tech.color : ''}`
                      : undefined;
                    return (
                      <li title={s}>
                        {src ? (
                          <img
                            src={src}
                            alt={s}
                            width="16"
                            height="16"
                            class:list={['h-4 w-4 shrink-0', { 'dark:invert': tech?.invertDark }]}
                            loading="lazy"
                          />
                        ) : (
                          <span class="font-mono text-[10px] text-[var(--color-accent)]">
                            {s.charAt(0)}
                          </span>
                        )}
                      </li>
                    );
                  })}
                </ul>
                {p.repoUrl && (
                  <a
                    href={p.repoUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`Código de ${p.name} en GitHub`}
                    class="relative z-20 text-[var(--color-muted)] transition-colors hover:text-[var(--color-fg)] dark:text-[var(--color-muted-dark)]"
                  >
                    <svg viewBox="0 0 24 24" class="h-4 w-4 fill-current" aria-hidden="true">
                      <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z" />
                    </svg>
                  </a>
                )}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

