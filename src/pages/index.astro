---
export const prerender = true;

import BaseLayout from '../presentation/layouts/BaseLayout.astro';

const valueProps = [
  {
    title: 'Carga al instante',
    body: 'Tu web aparece antes de que el visitante pierda interés. Velocidad real, en cualquier dispositivo.',
  },
  {
    title: 'Protegida desde el primer día',
    body: 'Cuido los datos de tus visitantes como si fueran míos. Sin formularios fáciles de hackear, sin spam.',
  },
  {
    title: 'Se ve perfecta en móvil',
    body: 'La mayoría de la gente entrará desde su teléfono. Diseñada para que ese sea su mejor lugar.',
  },
  {
    title: 'Para todos, sin excepción',
    body: 'Accesible para personas con discapacidad visual, motora o cognitiva. Buena para tus usuarios y para Google.',
  },
] as const;

interface ServicePreview {
  no: string;
  name: string;
  price: string;
  duration: string;
  description: string;
  features: readonly string[];
  highlighted?: boolean;
}

const servicesPreview: readonly ServicePreview[] = [
  {
    no: '01',
    name: 'Una página',
    price: '$1.200.000 COP',
    duration: '1–2 semanas',
    description: 'Lo esencial para que tu negocio exista en internet.',
    features: [
      'Diseño cuidado para móvil y computador',
      'Formulario con protección anti-spam',
      'Optimizada para Google',
    ],
  },
  {
    no: '02',
    name: 'Sitio completo',
    price: '$2.500.000 COP',
    duration: '2–4 semanas',
    description: 'Hasta seis páginas con identidad propia.',
    features: ['Diseño hecho a la medida', 'Blog o casos de éxito', 'Modo claro y modo oscuro'],
    highlighted: true,
  },
  {
    no: '03',
    name: 'Sitio + seguridad reforzada',
    price: '$4.200.000 COP',
    duration: '4–6 semanas',
    description: 'Cuando manejas datos sensibles o vas en serio.',
    features: [
      'Auditoría de seguridad documentada',
      'Reporte ejecutivo y técnico',
      'Acompañamiento post-entrega',
    ],
  },
];

const stats = [
  { value: '<1s', label: 'Tiempo de carga' },
  { value: '100%', label: 'Accesible en móvil' },
  { value: '24h', label: 'Tiempo de respuesta' },
  { value: '0', label: 'Costes ocultos' },
] as const;
---

<BaseLayout title="Inicio">
  <!-- ============================================================
       HERO editorial
       ============================================================ -->
  <section aria-labelledby="hero-title" class="py-12 sm:py-20">
    <div class="max-w-4xl">
      <p
        class="fade-in-up eyebrow-dot mb-6 inline-flex items-center text-xs font-medium tracking-wider uppercase"
      >
        Aceptando nuevos proyectos
      </p>

      <h1
        id="hero-title"
        class="fade-in-up fade-in-up-delay-1 max-w-3xl text-5xl leading-[1.05] font-semibold tracking-tight text-balance sm:text-6xl lg:text-7xl"
      >
        Hago webs que la gente
        <span class="italic-accent">recuerda</span>.
      </h1>

      <p
        class="fade-in-up fade-in-up-delay-2 mt-8 max-w-xl text-lg leading-relaxed text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]"
      >
        Soy Juan Sebastián. Diseño y construyo sitios web cuidados al detalle — rápidos, seguros y
        agradables de usar. El tipo de web del que tus clientes hablan después de cerrar el
        navegador.
      </p>

      <div class="fade-in-up fade-in-up-delay-3 mt-10 flex flex-col gap-3 sm:flex-row">
        <a
          href="/services"
          class="glow-on-hover inline-flex items-center justify-center rounded-md bg-[var(--color-accent)] px-7 py-3.5 text-sm font-medium text-white shadow-sm transition-colors hover:bg-[var(--color-accent-hover)]"
        >
          Ver planes y precios
          <svg
            class="ml-2 h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </a>
        <a
          href="/contact"
          class="inline-flex items-center justify-center rounded-md px-7 py-3.5 text-sm font-medium text-[var(--color-fg)] transition-colors hover:text-[var(--color-accent)] dark:text-[var(--color-fg-dark)]"
        >
          O escríbeme directamente →
        </a>
      </div>
    </div>
  </section>

  <!-- ============================================================
       STATS editoriales — números grandes
       ============================================================ -->
  <section
    aria-labelledby="stats-title"
    class="border-y border-[var(--color-border)] py-12 dark:border-[var(--color-border-dark)]"
  >
    <h2 id="stats-title" class="sr-only">Lo que recibes</h2>
    <div class="grid grid-cols-2 gap-x-8 gap-y-10 sm:grid-cols-4">
      {
        stats.map((s, i) => (
          <div class={`reveal reveal-delay-${Math.min(i, 3)}`}>
            <p class="big-number text-5xl sm:text-6xl">{s.value}</p>
            <p class="mt-2 text-xs tracking-wider text-[var(--color-muted)] uppercase dark:text-[var(--color-muted-dark)]">
              {s.label}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ============================================================
       VALUE PROPS — beneficios con número grande editorial
       ============================================================ -->
  <section
    aria-labelledby="value-title"
    class="border-b border-[var(--color-border)] py-16 sm:py-20 dark:border-[var(--color-border-dark)]"
  >
    <div class="reveal flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-xl">
        <p
          class="eyebrow-dot mb-4 inline-flex items-center text-xs font-medium tracking-wider uppercase"
        >
          Por qué trabajar conmigo
        </p>
        <h2 id="value-title" class="text-3xl font-semibold tracking-tight sm:text-4xl">
          Cuatro cosas que recibes <span class="italic-accent">siempre</span>.
        </h2>
      </div>
      <p class="max-w-xs text-sm text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]">
        Sin importar el tamaño del proyecto, todas mis webs cumplen lo mismo.
      </p>
    </div>

    <ul class="mt-14 grid grid-cols-1 gap-10 sm:grid-cols-2 lg:gap-12">
      {
        valueProps.map((v, i) => (
          <li class={`reveal reveal-delay-${Math.min(i, 3)} flex gap-6`}>
            <span class="big-number shrink-0 text-5xl leading-none">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div>
              <h3 class="text-xl font-semibold tracking-tight">{v.title}</h3>
              <p class="mt-2 text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]">
                {v.body}
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ============================================================
       SERVICES PREVIEW — filas editoriales con hover-slide
       ============================================================ -->
  <section
    aria-labelledby="services-preview-title"
    class="border-b border-[var(--color-border)] py-16 sm:py-20 dark:border-[var(--color-border-dark)]"
  >
    <div class="reveal flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-xl">
        <p
          class="eyebrow-dot mb-4 inline-flex items-center text-xs font-medium tracking-wider uppercase"
        >
          Cómo trabajamos
        </p>
        <h2 id="services-preview-title" class="text-3xl font-semibold tracking-tight sm:text-4xl">
          Tres planes <span class="italic-accent">claros y honestos</span>.
        </h2>
      </div>
      <a
        href="/services"
        class="group inline-flex items-center text-sm font-medium text-[var(--color-accent)]"
      >
        Ver el detalle
        <svg
          class="ml-1 h-4 w-4 transition-transform group-hover:translate-x-1"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6"></path>
        </svg>
      </a>
    </div>

    <ul class="mt-14 grid grid-cols-1 gap-5 md:grid-cols-3">
      {
        servicesPreview.map((s, i) => (
          <li
            class:list={[
              `reveal reveal-delay-${Math.min(i, 3)} lift flex flex-col rounded-2xl border bg-[var(--color-bg)] p-8 dark:bg-[var(--color-bg-dark)]`,
              s.highlighted
                ? 'border-[var(--color-accent)] shadow-[var(--color-accent)]/5 shadow-lg'
                : 'border-[var(--color-border)] dark:border-[var(--color-border-dark)]',
            ]}
          >
            <div class="flex items-center justify-between">
              <span class="big-number text-4xl leading-none">{s.no}</span>
              {s.highlighted && (
                <span class="rounded-full bg-gradient-to-r from-[var(--color-accent)] to-[var(--color-accent-2)] px-3 py-0.5 text-[10px] font-semibold tracking-wider text-white uppercase">
                  Más solicitado
                </span>
              )}
            </div>

            <h3 class="mt-6 text-xl font-semibold tracking-tight sm:text-2xl">{s.name}</h3>
            <p class="mt-2 text-sm text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]">
              {s.description}
            </p>

            <div class="mt-6 border-t border-[var(--color-border)] pt-6 dark:border-[var(--color-border-dark)]">
              <p class="italic-accent text-3xl leading-none">{s.price}</p>
              <p class="mt-2 text-xs tracking-wider text-[var(--color-muted)] uppercase dark:text-[var(--color-muted-dark)]">
                Entrega en {s.duration}
              </p>
            </div>

            <ul class="mt-6 flex-1 space-y-2.5 text-sm">
              {s.features.map((f) => (
                <li class="flex gap-2.5">
                  <svg
                    class="mt-0.5 h-4 w-4 shrink-0 text-[var(--color-accent)]"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    aria-hidden="true"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7" />
                  </svg>
                  <span class="text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]">
                    {f}
                  </span>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ============================================================
       FINAL CTA editorial
       ============================================================ -->
  <section class="py-16 sm:py-20">
    <div
      class="reveal relative isolate overflow-hidden rounded-3xl bg-gradient-to-br from-[var(--color-accent)] to-[var(--color-accent-2)] p-10 text-white sm:p-16"
    >
      <div
        class="absolute inset-0 bg-[radial-gradient(circle_at_30%_20%,rgba(255,255,255,0.15),transparent_60%)]"
        aria-hidden="true"
      >
      </div>
      <div class="relative max-w-2xl">
        <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl lg:text-5xl">
          Cuéntame tu <em class="font-serif font-medium italic">idea</em>.
        </h2>
        <p class="mt-4 text-lg text-white/90">
          Te respondo en menos de 24 horas con una propuesta clara y sin compromiso.
        </p>
        <a
          href="/contact"
          class="mt-8 inline-flex items-center justify-center rounded-md bg-white px-7 py-3.5 text-sm font-semibold text-[var(--color-accent)] shadow-lg transition-transform hover:scale-105"
        >
          Empezar conversación
          <svg
            class="ml-2 h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
