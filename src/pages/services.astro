---
export const prerender = true;

import BaseLayout from '../presentation/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Servicios"
  description="Servicios de desarrollo web seguro: landings, aplicaciones, auditoría de seguridad básica."
>
  <section class="py-12">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Servicios</h1>
    <p class="mt-4 text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]">
      Próximamente: catálogo de servicios de desarrollo web con foco en rendimiento, accesibilidad y
      buenas prácticas OWASP.
    </p>
  </section>
</BaseLayout>
