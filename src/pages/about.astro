---
export const prerender = true;

import BaseLayout from '../presentation/layouts/BaseLayout.astro';

const principles = [
  {
    title: 'Seguridad desde el primer día',
    body: 'Cuido los datos de tus visitantes con el mismo rigor que aplican los bancos. Sin atajos, sin "ya lo arreglaremos después".',
  },
  {
    title: 'Rápida o no se entrega',
    body: 'Una web lenta es una web perdida. La mía carga antes de que el visitante alcance a aburrirse.',
  },
  {
    title: 'Todo queda explicado',
    body: 'Te entrego documentación sencilla: qué hace cada parte, cómo cambiarla, cómo mantenerla. Sin dependencias eternas.',
  },
  {
    title: 'Honestidad por delante',
    body: 'Si lo que me pides está fuera de mis capacidades hoy, te lo digo. Prefiero rechazar un proyecto que entregar algo mediocre.',
  },
] as const;
---

<BaseLayout
  title="Sobre mí"
  description="Juan Sebastián Osorio (sogom) — desarrollador web colombiano. Construyo sitios cuidados, rápidos y seguros para personas y negocios reales."
>
  <section class="py-12 sm:py-20">
    <div class="grid grid-cols-1 items-start gap-10 lg:grid-cols-[1.4fr_1fr] lg:gap-16">
      <!-- Columna izquierda: texto -->
      <div>
        <p
          class="fade-in-up eyebrow-dot mb-6 inline-flex items-center text-xs font-medium tracking-wider uppercase"
        >
          Sobre mí
        </p>
        <h1
          class="fade-in-up fade-in-up-delay-1 text-4xl leading-[1.1] font-semibold tracking-tight text-balance sm:text-5xl lg:text-6xl"
        >
          Trabajo con la <span class="italic-accent">cabeza fría</span> y la atención al detalle de
          quien estudia seguridad.
        </h1>

        <div
          class="fade-in-up fade-in-up-delay-2 mt-10 space-y-6 text-lg leading-relaxed text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]"
        >
          <p>
            Me llamo <strong class="text-[var(--color-fg)] dark:text-[var(--color-fg-dark)]"
              >Juan Sebastián Osorio</strong
            >, colombiano, y mi día se reparte entre escribir páginas web y estudiar cómo se rompen
            las que no están bien hechas. Esa mezcla rara es justo lo que define mi forma de
            trabajar.
          </p>
          <p>
            Cuando hago una web para alguien, no estoy solo "diseñando bonito". Pienso en cada
            formulario como una puerta que puede abrir un atacante. Pienso en cada imagen como un
            kilobyte extra que ralentiza la página. Pienso en cada visitante como una persona real
            con prisa y un móvil viejo.
          </p>
          <p>
            Estoy en el inicio de mi camino freelance. Eso significa precios accesibles y, sobre
            todo, una atención al detalle que no encuentras en agencias grandes con quince clientes
            a la vez. Aquí tú no eres un número.
          </p>
        </div>
      </div>

      <!-- Columna derecha: foto profesional -->
      <div class="fade-in-up fade-in-up-delay-1 relative lg:sticky lg:top-24">
        <div class="relative aspect-[4/5] overflow-hidden rounded-2xl bg-[var(--color-border)] dark:bg-[var(--color-border-dark)]">
          <img
            src="/juan-sebastian.webp"
            alt="Juan Sebastián Osorio, desarrollador web, sonriendo en un espacio de trabajo"
            width="800"
            height="1000"
            loading="eager"
            decoding="async"
            class="h-full w-full object-cover"
          />
        </div>
        <!-- Marco decorativo offset detrás de la foto (estilo editorial) -->
        <div
          aria-hidden="true"
          class="absolute -right-3 -bottom-3 -z-10 hidden h-full w-full rounded-2xl border border-[var(--color-accent)]/30 lg:block"
        >
        </div>
      </div>
    </div>
  </section>

  <section
    aria-labelledby="principles-title"
    class="border-t border-[var(--color-border)] py-16 sm:py-20 dark:border-[var(--color-border-dark)]"
  >
    <div class="reveal max-w-2xl">
      <p class="mb-4 text-xs font-medium tracking-wider text-[var(--color-accent)] uppercase">
        Cómo trabajo
      </p>
      <h2 id="principles-title" class="text-3xl font-semibold tracking-tight sm:text-4xl">
        Cuatro reglas que <span class="italic-accent">no negocio</span>.
      </h2>
    </div>

    <ul class="mt-14 grid grid-cols-1 gap-8 sm:grid-cols-2">
      {
        principles.map((p, i) => (
          <li class={`reveal reveal-delay-${Math.min(i, 3)} flex gap-5`}>
            <span
              class="mt-1 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-[var(--color-accent)] to-[var(--color-accent-2)] text-sm font-semibold text-white"
              aria-hidden="true"
            >
              {String(i + 1).padStart(2, '0')}
            </span>
            <div>
              <h3 class="text-lg font-semibold">{p.title}</h3>
              <p class="mt-2 text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]">
                {p.body}
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section
    aria-labelledby="tools-title"
    class="border-t border-[var(--color-border)] py-16 sm:py-20 dark:border-[var(--color-border-dark)]"
  >
    <div class="reveal max-w-2xl">
      <p
        class="eyebrow-dot mb-4 inline-flex items-center text-xs font-medium tracking-wider uppercase"
      >
        Herramientas
      </p>
      <h2 id="tools-title" class="text-3xl font-semibold tracking-tight sm:text-4xl">
        Con qué <span class="italic-accent">construyo</span>.
      </h2>
      <p class="mt-4 text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]">
        Para quien le interese el detalle técnico. Si no, puedes saltar directo a los servicios.
      </p>
    </div>

    <div class="reveal reveal-delay-1 mt-12 grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-3">
      <div>
        <h3 class="text-xs font-semibold tracking-wider text-[var(--color-accent)] uppercase">
          Lenguajes
        </h3>
        <ul class="mt-4 space-y-2 text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]">
          <li>JavaScript · TypeScript</li>
          <li>Python · Java</li>
          <li>C# · C++</li>
        </ul>
      </div>
      <div>
        <h3 class="text-xs font-semibold tracking-wider text-[var(--color-accent)] uppercase">
          Frontend & web
        </h3>
        <ul class="mt-4 space-y-2 text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]">
          <li>React · Astro</li>
          <li>Tailwind CSS · HTML5</li>
          <li>Accesibilidad WCAG</li>
        </ul>
      </div>
      <div>
        <h3 class="text-xs font-semibold tracking-wider text-[var(--color-accent)] uppercase">
          Bases de datos
        </h3>
        <ul class="mt-4 space-y-2 text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]">
          <li>PostgreSQL</li>
          <li>SQL · consultas optimizadas</li>
          <li>Modelado relacional</li>
        </ul>
      </div>
      <div>
        <h3 class="text-xs font-semibold tracking-wider text-[var(--color-accent)] uppercase">
          Servidores & sistemas
        </h3>
        <ul class="mt-4 space-y-2 text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]">
          <li>Administración Linux</li>
          <li>Administración Windows Server</li>
          <li>Configuración y monitoreo</li>
        </ul>
      </div>
      <div>
        <h3 class="text-xs font-semibold tracking-wider text-[var(--color-accent)] uppercase">
          Seguridad
        </h3>
        <ul class="mt-4 space-y-2 text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]">
          <li>OWASP Top 10</li>
          <li>Cabeceras HTTP de seguridad</li>
          <li>Anti-bot y rate limiting</li>
        </ul>
      </div>
      <div>
        <h3 class="text-xs font-semibold tracking-wider text-[var(--color-accent)] uppercase">
          DevOps
        </h3>
        <ul class="mt-4 space-y-2 text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]">
          <li>Git · GitHub Actions</li>
          <li>Vercel · Despliegues continuos</li>
          <li>Testing automatizado</li>
        </ul>
      </div>
    </div>
  </section>

  <section
    class="border-t border-[var(--color-border)] py-16 sm:py-20 dark:border-[var(--color-border-dark)]"
  >
    <div
      class="reveal flex flex-col items-start gap-6 sm:flex-row sm:items-center sm:justify-between"
    >
      <div>
        <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">
          ¿Tienes una idea en mente?
        </h2>
        <p class="mt-2 text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]">
          Te respondo en menos de 24 horas.
        </p>
      </div>
      <a
        href="/contact"
        class="glow-on-hover inline-flex items-center justify-center rounded-md bg-[var(--color-accent)] px-7 py-3.5 text-sm font-medium text-white shadow-sm transition-colors hover:bg-[var(--color-accent-hover)]"
      >
        Hablemos
      </a>
    </div>
  </section>
</BaseLayout>
