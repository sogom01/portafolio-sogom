---
export const prerender = true;

import BaseLayout from '../presentation/layouts/BaseLayout.astro';

const values = [
  {
    title: 'Seguridad desde la primera línea',
    body: 'Cada página o endpoint que escribo pasa por una checklist OWASP. La seguridad no se "añade al final", se diseña con el código.',
  },
  {
    title: 'Rendimiento y accesibilidad como base',
    body: 'Objetivo Lighthouse ≥ 95 en Performance y 100 en Accesibilidad. Sin esto, el resto no importa.',
  },
  {
    title: 'Decisiones documentadas',
    body: 'Cada decisión técnica importante queda explicada en el repo. Si te entregas algo, sabes por qué está hecho así.',
  },
  {
    title: 'Honestidad sobre el alcance',
    body: 'Prefiero decir "esto está fuera de mis capacidades actuales" antes que cobrar y entregar algo mediocre. Si no es mi terreno, te paso a alguien mejor.',
  },
] as const;
---

<BaseLayout
  title="Sobre mí"
  description="Juan Sebastián Osorio — desarrollador web colombiano con foco en seguridad informática. Construyo sitios rápidos, accesibles y endurecidos contra OWASP Top 10."
>
  <section class="relative isolate overflow-hidden py-12 sm:py-16">
    <div class="blob blob-purple top-[-60px] right-[-40px] h-[260px] w-[260px]" aria-hidden="true">
    </div>

    <p
      class="fade-in-up mb-4 text-sm font-medium tracking-wide text-[var(--color-accent)] uppercase"
    >
      Sobre mí
    </p>
    <h1
      class="fade-in-up fade-in-up-delay-1 max-w-3xl text-3xl font-bold tracking-tight text-balance sm:text-4xl lg:text-5xl"
    >
      Construyo web seria con la mentalidad de un
      <span class="gradient-text">estudiante de seguridad.</span>
    </h1>

    <div
      class="mt-8 max-w-3xl space-y-5 text-lg leading-relaxed text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]"
    >
      <p>
        Soy <strong class="text-[var(--color-fg)] dark:text-[var(--color-fg-dark)]"
          >Juan Sebastián Osorio Gómez</strong
        >, desarrollador web colombiano y estudiante de seguridad de la información. Mi día a día se
        reparte entre escribir código que funciona y leer reportes de vulnerabilidades para entender
        cómo otros lo rompen.
      </p>
      <p>
        Trabajo principalmente con <strong>Astro, TypeScript estricto, Tailwind y Python</strong>, y
        aplico los principios del OWASP Top 10 desde el primer commit: validación con Zod,
        sanitización, headers de seguridad, rate limiting, logging sin filtrar PII. Lo que aparece
        en el currículum, también aparece en mi código.
      </p>
      <p>
        Estoy al principio de mi camino freelance. Eso significa dos cosas: precios razonables y una <strong
          >obsesión personal con cada entrega</strong
        >, porque cada cliente es una oportunidad de construir reputación. No vendo humo: prefiero
        trabajos pequeños bien hechos a proyectos enormes que no pueda sostener.
      </p>
    </div>
  </section>

  <section
    aria-labelledby="values-title"
    class="border-t border-[var(--color-border)] py-12 sm:py-16 dark:border-[var(--color-border-dark)]"
  >
    <h2 id="values-title" class="text-2xl font-semibold tracking-tight sm:text-3xl">
      Cómo trabajo
    </h2>
    <p class="mt-3 max-w-2xl text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]">
      Cuatro principios que aplico a cualquier proyecto, sin importar el tamaño.
    </p>

    <ul class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2">
      {
        values.map((v, i) => (
          <li
            class={`reveal reveal-delay-${Math.min(i, 3)} lift rounded-lg border border-[var(--color-border)] bg-[var(--color-bg)] p-5 dark:border-[var(--color-border-dark)] dark:bg-[var(--color-bg-dark)]`}
          >
            <h3 class="font-semibold">{v.title}</h3>
            <p class="mt-2 text-sm text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]">
              {v.body}
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  <section
    aria-labelledby="stack-title"
    class="border-t border-[var(--color-border)] py-12 sm:py-16 dark:border-[var(--color-border-dark)]"
  >
    <h2 id="stack-title" class="text-2xl font-semibold tracking-tight sm:text-3xl">
      Stack y herramientas
    </h2>

    <div class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-3">
      <div>
        <h3 class="text-sm font-semibold tracking-wide uppercase">Frontend</h3>
        <ul
          class="mt-3 space-y-1.5 text-sm text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]"
        >
          <li>Astro · TypeScript estricto</li>
          <li>Tailwind CSS · accesibilidad WCAG</li>
          <li>Vite · ESLint · Prettier</li>
        </ul>
      </div>
      <div>
        <h3 class="text-sm font-semibold tracking-wide uppercase">Backend & datos</h3>
        <ul
          class="mt-3 space-y-1.5 text-sm text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]"
        >
          <li>Node.js · funciones serverless</li>
          <li>Python · FastAPI · scripts de automatización</li>
          <li>PostgreSQL · validación con Zod</li>
        </ul>
      </div>
      <div>
        <h3 class="text-sm font-semibold tracking-wide uppercase">Seguridad & ops</h3>
        <ul
          class="mt-3 space-y-1.5 text-sm text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]"
        >
          <li>OWASP Top 10 · Burp Suite básico</li>
          <li>Headers HTTP · CSP · CORS</li>
          <li>CI/CD GitHub Actions · Vercel</li>
        </ul>
      </div>
    </div>
  </section>

  <section
    class="border-t border-[var(--color-border)] py-12 sm:py-16 dark:border-[var(--color-border-dark)]"
  >
    <div class="flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h2 class="text-2xl font-semibold tracking-tight">¿Tienes un proyecto en mente?</h2>
        <p class="mt-2 text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]">
          Cuéntame qué necesitas y te respondo en menos de 48 horas.
        </p>
      </div>
      <a
        href="/contact"
        class="inline-flex items-center justify-center rounded-md bg-[var(--color-accent)] px-5 py-2.5 text-sm font-medium text-white shadow-sm transition-colors hover:bg-[var(--color-accent-hover)]"
      >
        Contáctame
      </a>
    </div>
  </section>
</BaseLayout>
