---
export const prerender = true;

import BaseLayout from '../presentation/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Sobre mí"
  description="Conoce a Juan Sebastián Osorio Gómez — desarrollador web y estudiante de seguridad informática."
>
  <section class="py-12">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Sobre mí</h1>
    <p class="mt-4 text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]">
      Esta sección está en construcción. Pronto encontrarás aquí mi trayectoria, formación y lo que
      me motiva a unir desarrollo web con seguridad informática.
    </p>
  </section>
</BaseLayout>
