---
export const prerender = true;

import BaseLayout from '../presentation/layouts/BaseLayout.astro';

interface Project {
  title: string;
  subtitle: string;
  description: string;
  stack: readonly string[];
  highlights: readonly string[];
  liveUrl?: string;
  repoUrl?: string;
  status: 'live' | 'in-progress' | 'planned';
}

const featured: Project = {
  title: 'Este mismo portafolio',
  subtitle: 'Mi propio sitio, hecho como ejemplo de mi forma de trabajar',
  description:
    'La web donde estás ahora. Construida desde cero para mostrarte cómo hago las cosas: rápida, accesible, sin trucos, y lista para resistir el uso real.',
  stack: ['Astro', 'TypeScript', 'Tailwind', 'Vercel', 'Cloudflare', 'Resend'],
  highlights: [
    'Carga en menos de un segundo en cualquier dispositivo',
    'Se ve perfecta en móvil, tablet y computador',
    'Funciona para personas con discapacidad visual o motora',
    'El formulario de contacto está protegido contra spam y bots',
    'Cada cambio se verifica automáticamente antes de publicarse',
    'Modo claro y modo oscuro, ambos cuidados al detalle',
  ],
  liveUrl: 'https://portafoliosogom.vercel.app',
  repoUrl: 'https://github.com/sogom01/portafolio-sogom',
  status: 'live',
};

const upcoming: readonly Project[] = [
  {
    title: 'Análisis de seguridad para una app vulnerable',
    subtitle: 'Mostrando cómo trabajo cuando reviso la seguridad de un sitio',
    description:
      'Voy a tomar una aplicación creada a propósito con fallos de seguridad, la analizaré paso a paso, y publicaré el reporte. Para que veas cómo trabajo cuando hago auditorías reales.',
    stack: ['Análisis manual', 'Herramientas profesionales', 'Reporte en PDF'],
    highlights: [
      'Identifico problemas reales como un atacante los vería',
      'Cada hallazgo viene con su prueba y su solución',
      'Reporte legible para no técnicos',
      'Plantilla que reutilizaré con clientes reales',
    ],
    status: 'in-progress',
  },
  {
    title: 'Web para un negocio real',
    subtitle: 'Mi primer cliente, documentado de principio a fin',
    description:
      'Cuando llegue el primer cliente (puede que seas tú), voy a documentar el proceso completo: qué pidió, qué construí, cómo se ven los resultados.',
    stack: ['Diseño desde cero', 'Métricas antes/después', 'Aprendizajes'],
    highlights: [
      'Diseño hecho a partir de la conversación con el cliente',
      'Números reales: visitas, contactos, conversión',
      'Lo bueno y lo difícil del proceso, todo contado',
    ],
    status: 'planned',
  },
] as const;

const statusLabel = {
  live: { text: 'En línea', class: 'bg-green-600/15 text-green-700 dark:text-green-400' },
  'in-progress': {
    text: 'En desarrollo',
    class: 'bg-amber-500/15 text-amber-700 dark:text-amber-400',
  },
  planned: {
    text: 'Próximamente',
    class: 'bg-[var(--color-accent)]/15 text-[var(--color-accent)]',
  },
};
---

<BaseLayout
  title="Proyectos"
  description="Casos reales de Juan Sebastián Osorio (sogom). Webs cuidadas, con resultados a la vista y proceso documentado."
>
  <section class="py-12 sm:py-20">
    <p
      class="fade-in-up mb-6 text-xs font-medium tracking-wider text-[var(--color-accent)] uppercase"
    >
      Proyectos
    </p>
    <h1
      class="fade-in-up fade-in-up-delay-1 max-w-3xl text-4xl leading-[1.1] font-semibold tracking-tight text-balance sm:text-5xl lg:text-6xl"
    >
      Trabajos reales, <span class="gradient-text">contados con claridad.</span>
    </h1>
    <p
      class="fade-in-up fade-in-up-delay-2 mt-6 max-w-2xl text-lg text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]"
    >
      Estoy al inicio de mi etapa freelance. Esta sección crecerá rápido — mientras tanto, esta
      misma web es un proyecto completo que puedes revisar de arriba a abajo.
    </p>
  </section>

  <!-- DESTACADO -->
  <section aria-labelledby="featured-title" class="pb-16">
    <h2 id="featured-title" class="sr-only">Proyecto destacado</h2>

    <article
      class="reveal gradient-border rounded-2xl bg-gradient-to-br from-[var(--color-accent)]/[0.03] to-[var(--color-accent-2)]/[0.03] p-8 sm:p-10 dark:from-[var(--color-accent)]/[0.06] dark:to-[var(--color-accent-2)]/[0.06]"
    >
      <div class="flex flex-wrap items-center gap-3">
        <span
          class={`inline-flex rounded-full px-3 py-0.5 text-xs font-semibold ${statusLabel[featured.status].class}`}
        >
          {statusLabel[featured.status].text}
        </span>
        <span
          class="text-xs tracking-wider text-[var(--color-muted)] uppercase dark:text-[var(--color-muted-dark)]"
        >
          Caso de muestra
        </span>
      </div>

      <h3 class="mt-5 text-3xl font-semibold tracking-tight sm:text-4xl">
        {featured.title}
      </h3>
      <p class="mt-2 text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]">
        {featured.subtitle}
      </p>

      <p
        class="mt-6 max-w-3xl text-lg leading-relaxed text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]"
      >
        {featured.description}
      </p>

      <div class="mt-8">
        <h4 class="text-xs font-semibold tracking-wider uppercase">Construida con</h4>
        <ul class="mt-3 flex flex-wrap gap-2">
          {
            featured.stack.map((tech) => (
              <li class="rounded-md border border-[var(--color-border)] px-3 py-1 text-xs dark:border-[var(--color-border-dark)]">
                {tech}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="mt-8">
        <h4 class="text-xs font-semibold tracking-wider uppercase">Lo que recibes</h4>
        <ul class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-2">
          {
            featured.highlights.map((h) => (
              <li class="flex gap-3 text-sm">
                <svg
                  class="h-5 w-5 shrink-0 text-[var(--color-accent)]"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  aria-hidden="true"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7" />
                </svg>
                <span>{h}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="mt-10 flex flex-wrap gap-3">
        {
          featured.liveUrl && (
            <a
              href={featured.liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="glow-on-hover inline-flex items-center justify-center rounded-md bg-[var(--color-accent)] px-6 py-3 text-sm font-medium text-white shadow-sm transition-colors hover:bg-[var(--color-accent-hover)]"
            >
              Ver la web en vivo ↗
            </a>
          )
        }
        {
          featured.repoUrl && (
            <a
              href={featured.repoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center rounded-md border border-[var(--color-border)] px-6 py-3 text-sm font-medium text-[var(--color-fg)] transition-colors hover:border-[var(--color-accent)] dark:border-[var(--color-border-dark)] dark:text-[var(--color-fg-dark)]"
            >
              Revisar el código ↗
            </a>
          )
        }
      </div>
    </article>
  </section>

  <!-- ROADMAP -->
  <section
    aria-labelledby="roadmap-title"
    class="border-t border-[var(--color-border)] py-16 sm:py-20 dark:border-[var(--color-border-dark)]"
  >
    <div class="reveal max-w-2xl">
      <p class="mb-4 text-xs font-medium tracking-wider text-[var(--color-accent)] uppercase">
        Próximos casos
      </p>
      <h2 id="roadmap-title" class="text-3xl font-semibold tracking-tight sm:text-4xl">
        Lo que viene <span class="gradient-text">en los siguientes meses.</span>
      </h2>
      <p class="mt-4 text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]">
        Prefiero anunciar lo que estoy construyendo a inventar trabajos que no he hecho.
      </p>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2">
      {
        upcoming.map((p, i) => (
          <article
            class={`reveal reveal-delay-${Math.min(i, 3)} lift flex flex-col rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg)] p-7 dark:border-[var(--color-border-dark)] dark:bg-[var(--color-bg-dark)]`}
          >
            <span
              class={`inline-flex w-fit rounded-full px-3 py-0.5 text-xs font-semibold ${statusLabel[p.status].class}`}
            >
              {statusLabel[p.status].text}
            </span>
            <h3 class="mt-4 text-xl font-semibold tracking-tight">{p.title}</h3>
            <p class="mt-2 text-sm text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]">
              {p.subtitle}
            </p>
            <p class="mt-4 text-sm text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]">
              {p.description}
            </p>
          </article>
        ))
      }
    </div>
  </section>

  <section
    class="border-t border-[var(--color-border)] py-16 sm:py-20 dark:border-[var(--color-border-dark)]"
  >
    <div
      class="reveal flex flex-col items-start gap-6 sm:flex-row sm:items-center sm:justify-between"
    >
      <div>
        <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">
          ¿Quieres ser uno de los primeros?
        </h2>
        <p class="mt-2 text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]">
          Precio especial de lanzamiento, atención completa y proceso documentado.
        </p>
      </div>
      <a
        href="/contact"
        class="glow-on-hover inline-flex items-center justify-center rounded-md bg-[var(--color-accent)] px-7 py-3.5 text-sm font-medium text-white shadow-sm transition-colors hover:bg-[var(--color-accent-hover)]"
      >
        Hablemos
      </a>
    </div>
  </section>
</BaseLayout>
