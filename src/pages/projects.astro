---
export const prerender = true;

import BaseLayout from '../presentation/layouts/BaseLayout.astro';

interface Project {
  title: string;
  subtitle: string;
  description: string;
  stack: readonly string[];
  highlights: readonly string[];
  liveUrl?: string;
  repoUrl?: string;
  status: 'live' | 'in-progress' | 'planned';
}

const featured: Project = {
  title: 'Este mismo portafolio',
  subtitle: 'Caso de estudio · Astro + TypeScript estricto + Tailwind',
  description:
    'El sitio donde estás ahora. Construido como demostración pública de mi forma de trabajar: estructura por capas, validación con Zod, formulario serverless con cuatro capas de defensa anti-spam, y CI/CD verde antes de cada deploy.',
  stack: [
    'Astro 6',
    'TypeScript strict',
    'Tailwind CSS 4',
    'Vercel (SSR híbrido)',
    'Cloudflare Turnstile',
    'Resend',
    'Vitest',
  ],
  highlights: [
    'Render estático con islas mínimas de JS (≈ 3 KB total cliente)',
    'Endpoint /api/contact con rate limit, validación Zod, honeypot y verificación Turnstile',
    'IP hasheada con sal para logging GDPR-friendly',
    '30 tests unitarios sobre lógica y servicios, cobertura ≥ 80%',
    'GitHub Actions: lint + typecheck + tests + build en cada PR',
    'Accesibilidad WCAG AA: skip link, ARIA roles, foco visible, modo oscuro accesible',
    'Headers HTTP endurecidos (HSTS, X-Frame-Options, Referrer-Policy)',
    'Lighthouse: Performance 95+, Accessibility 100, Best Practices 100, SEO 100',
  ],
  liveUrl: 'https://portafoliosogom.vercel.app',
  repoUrl: 'https://github.com/sogom01/portafolio-jso',
  status: 'live',
};

const upcoming: readonly Project[] = [
  {
    title: 'Demo de auditoría OWASP Top 10',
    subtitle: 'Caso práctico · análisis de seguridad en una app vulnerable',
    description:
      'Tomaré una aplicación intencionalmente vulnerable (Juice Shop o DVWA), la auditaré contra OWASP Top 10 y publicaré el reporte ejecutivo + técnico. Mostrará cómo trabajaría en una auditoría real.',
    stack: ['Burp Suite', 'OWASP ZAP', 'Reporte PDF', 'Mitigaciones documentadas'],
    highlights: [
      'Identificación de vulnerabilidades reales',
      'Reproducción paso a paso con capturas',
      'Recomendaciones priorizadas por riesgo',
      'Plantilla reutilizable para clientes',
    ],
    status: 'in-progress',
  },
  {
    title: 'Landing comercial para pyme',
    subtitle: 'Caso real · sitio de producción para un negocio local',
    description:
      'Aplicaré el paquete "Landing Profesional" sobre un cliente real (restaurante, dentista o tienda local). Será el primer caso de estudio fuera del portafolio.',
    stack: ['Astro', 'Tailwind', 'Resend', 'Vercel', 'Dominio propio'],
    highlights: [
      'Diseño desde brief del cliente',
      'Métricas reales pre/post lanzamiento',
      'Lecciones aprendidas documentadas',
    ],
    status: 'planned',
  },
] as const;

const statusLabel = {
  live: { text: 'En producción', class: 'bg-green-600/15 text-green-700 dark:text-green-400' },
  'in-progress': {
    text: 'En desarrollo',
    class: 'bg-amber-500/15 text-amber-700 dark:text-amber-400',
  },
  planned: {
    text: 'Próximamente',
    class: 'bg-blue-500/15 text-blue-700 dark:text-blue-400',
  },
};
---

<BaseLayout
  title="Proyectos"
  description="Proyectos de desarrollo web y seguridad de Juan Sebastián Osorio. Casos de estudio reales con stack y resultados documentados."
>
  <section class="py-12 sm:py-16">
    <p class="mb-4 text-sm font-medium tracking-wide text-[var(--color-accent)] uppercase">
      Proyectos
    </p>
    <h1 class="max-w-3xl text-3xl font-bold tracking-tight text-balance sm:text-4xl lg:text-5xl">
      Trabajo real, decisiones documentadas.
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]">
      Estoy al inicio de mi etapa freelance. Esta sección crecerá rápido — mientras tanto, este
      portafolio mismo es un proyecto completo que puedes auditar línea por línea.
    </p>
  </section>

  <section aria-labelledby="featured-title" class="pb-12">
    <h2 id="featured-title" class="sr-only">Proyecto destacado</h2>

    <article
      class="rounded-xl border border-[var(--color-border)] p-6 sm:p-8 dark:border-[var(--color-border-dark)]"
    >
      <div class="flex flex-wrap items-center gap-3">
        <span
          class={`inline-flex rounded-full px-3 py-0.5 text-xs font-semibold ${statusLabel[featured.status].class}`}
        >
          {statusLabel[featured.status].text}
        </span>
        <span
          class="text-xs tracking-wide text-[var(--color-muted)] uppercase dark:text-[var(--color-muted-dark)]"
        >
          Caso de estudio
        </span>
      </div>

      <h3 class="mt-4 text-2xl font-bold tracking-tight sm:text-3xl">
        {featured.title}
      </h3>
      <p class="mt-1 text-sm text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]">
        {featured.subtitle}
      </p>

      <p class="mt-5 text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]">
        {featured.description}
      </p>

      <div class="mt-6">
        <h4 class="text-sm font-semibold tracking-wide uppercase">Stack</h4>
        <ul class="mt-2 flex flex-wrap gap-2">
          {
            featured.stack.map((tech) => (
              <li class="rounded-md border border-[var(--color-border)] px-2.5 py-1 text-xs dark:border-[var(--color-border-dark)]">
                {tech}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="mt-6">
        <h4 class="text-sm font-semibold tracking-wide uppercase">Lo destacable</h4>
        <ul class="mt-2 space-y-1.5 text-sm">
          {
            featured.highlights.map((h) => (
              <li class="flex gap-2">
                <svg
                  class="h-5 w-5 shrink-0 text-[var(--color-accent)]"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  aria-hidden="true"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7" />
                </svg>
                <span>{h}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="mt-6 flex flex-wrap gap-3">
        {
          featured.liveUrl && (
            <a
              href={featured.liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center rounded-md bg-[var(--color-accent)] px-5 py-2.5 text-sm font-medium text-white shadow-sm transition-colors hover:bg-[var(--color-accent-hover)]"
            >
              Ver sitio en vivo ↗
            </a>
          )
        }
        {
          featured.repoUrl && (
            <a
              href={featured.repoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center rounded-md border border-[var(--color-border)] px-5 py-2.5 text-sm font-medium text-[var(--color-fg)] transition-colors hover:bg-[var(--color-border)] dark:border-[var(--color-border-dark)] dark:text-[var(--color-fg-dark)] dark:hover:bg-[var(--color-border-dark)]"
            >
              Ver código en GitHub ↗
            </a>
          )
        }
      </div>
    </article>
  </section>

  <section
    aria-labelledby="roadmap-title"
    class="border-t border-[var(--color-border)] py-12 dark:border-[var(--color-border-dark)]"
  >
    <h2 id="roadmap-title" class="text-2xl font-semibold tracking-tight sm:text-3xl">
      Próximos casos de estudio
    </h2>
    <p class="mt-3 max-w-2xl text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]">
      Lo que estoy construyendo a continuación. Prefiero anunciarlo así que inventar trabajos que no
      he hecho.
    </p>

    <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-2">
      {
        upcoming.map((p) => (
          <article class="flex flex-col rounded-xl border border-[var(--color-border)] p-6 dark:border-[var(--color-border-dark)]">
            <span
              class={`inline-flex w-fit rounded-full px-3 py-0.5 text-xs font-semibold ${statusLabel[p.status].class}`}
            >
              {statusLabel[p.status].text}
            </span>
            <h3 class="mt-3 text-xl font-semibold tracking-tight">{p.title}</h3>
            <p class="mt-1 text-sm text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]">
              {p.subtitle}
            </p>
            <p class="mt-3 text-sm text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]">
              {p.description}
            </p>

            <div class="mt-4">
              <ul class="flex flex-wrap gap-1.5">
                {p.stack.map((tech) => (
                  <li class="rounded-md border border-[var(--color-border)] px-2 py-0.5 text-xs dark:border-[var(--color-border-dark)]">
                    {tech}
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section
    class="border-t border-[var(--color-border)] py-12 sm:py-16 dark:border-[var(--color-border-dark)]"
  >
    <div class="flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h2 class="text-2xl font-semibold tracking-tight">¿Quieres ser el primer cliente?</h2>
        <p class="mt-2 text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]">
          Tarifa de lanzamiento + documentación detallada del proceso para ti.
        </p>
      </div>
      <a
        href="/contact"
        class="inline-flex items-center justify-center rounded-md bg-[var(--color-accent)] px-5 py-2.5 text-sm font-medium text-white shadow-sm transition-colors hover:bg-[var(--color-accent-hover)]"
      >
        Hablemos
      </a>
    </div>
  </section>
</BaseLayout>
