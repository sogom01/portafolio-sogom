---
export const prerender = true;

import BaseLayout from '../presentation/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Proyectos"
  description="Proyectos de desarrollo web y seguridad informática de Juan Sebastián Osorio."
>
  <section class="py-12">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Proyectos</h1>
    <p class="mt-4 text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]">
      Estoy construyendo los primeros proyectos demo. Vuelve pronto para ver casos prácticos con su
      respectivo análisis de seguridad.
    </p>
  </section>
</BaseLayout>
