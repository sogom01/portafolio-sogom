---
export const prerender = true;

import BaseLayout from '../presentation/layouts/BaseLayout.astro';

interface Project {
  title: string;
  subtitle: string;
  description: string;
  stack: readonly string[];
  highlights: readonly string[];
  liveUrl?: string;
  repoUrl?: string;
  status: 'live' | 'in-progress' | 'planned';
}

const featured: Project = {
  title: 'Este mismo portafolio',
  subtitle: 'Mi propio sitio, hecho como muestra de mi forma de trabajar',
  description:
    'La web donde estás ahora. Construida desde cero para mostrarte cómo hago las cosas: rápida, accesible, sin trucos, y lista para resistir el uso real.',
  stack: ['Astro', 'TypeScript', 'Tailwind', 'Vercel', 'Cloudflare', 'Resend'],
  highlights: [
    'Carga en menos de un segundo en cualquier dispositivo',
    'Se ve perfecta en móvil, tablet y computador',
    'Funciona para personas con discapacidad visual o motora',
    'El formulario de contacto está protegido contra spam y bots',
    'Cada cambio se verifica automáticamente antes de publicarse',
    'Modo claro y modo oscuro, ambos cuidados al detalle',
  ],
  liveUrl: 'https://portafoliosogom.vercel.app',
  repoUrl: 'https://github.com/sogom01/portafolio-sogom',
  status: 'live',
};

type ConceptStatus = 'concept' | 'building';

interface Concept {
  name: string;
  category: string;
  tagline: string;
  description: string;
  palette: readonly string[]; // colores hex para mostrar paleta
  stack: readonly string[];
  imageGradient: string; // gradient css para la miniatura
  status?: ConceptStatus; // por defecto 'concept' (landing diseñada). 'building' = app en desarrollo
  liveUrl?: string; // si ya está desplegado
  repoUrl?: string; // repositorio público
  previewImage?: string; // ruta local en /public, ej: '/projects/marfil-preview.webp'
}

const concepts: readonly Concept[] = [
  {
    name: 'SIEMLogs',
    category: 'Ciberseguridad · Monitoreo de eventos',
    tagline: 'Visibilidad total sobre tus incidentes.',
    description:
      'Dashboard de práctica para simular un SIEM empresarial: centraliza logs, clasifica eventos por severidad y muestra el estado de incidentes en tiempo real. Construido para explorar arquitecturas fullstack con diseño y estructura de nivel corporativo.',
    palette: ['#0A0A0F', '#6C63FF', '#F5F5FF', '#1A1A2E'],
    stack: ['Astro', 'TypeScript', 'Tailwind CSS', 'Vercel'],
    imageGradient: 'linear-gradient(135deg, #0A0A0F 0%, #1A1A2E 50%, #6C63FF 100%)',
    status: 'building',
    liveUrl: 'https://gestor-siem.vercel.app/',
    repoUrl: 'https://github.com/sogom01/gestor-siem',
    previewImage: '/projects/gestor-siem.preview.webp',
  },
  {
    name: 'Pulso',
    category: 'Estudio creativo · Marketing',
    tagline: 'Marcas que la gente recuerda.',
    description:
      'Landing para estudio de marketing que comunica servicios, casos de éxito y filosofía de marca en un solo scroll. El visitante entiende en segundos qué hace el estudio, ve evidencia real del trabajo y encuentra un camino directo para iniciar una conversación.',
    palette: ['#F2F0EA', '#2A2BF5', '#14130F', '#FBFAF6'],
    stack: ['HTML', 'Tailwind CSS', 'JavaScript'],
    imageGradient: 'linear-gradient(135deg, #F2F0EA 0%, #2A2BF5 60%, #14130F 100%)',
    liveUrl: 'https://marketing-agency-pulso.vercel.app/',
    repoUrl: 'https://github.com/sogom01/Marketing-Agency',
    previewImage: '/projects/marketing-agency-pulso.preview.webp',
  },
  {
    name: 'Café Señor Martin',
    category: 'Café de origen · Sabor, Tradición y Origen',
    tagline: 'Donde la montaña se vuelve tinto.',
    description:
      'Landing para café de especialidad en Pereira que conecta al visitante con el origen del grano: la historia del cultivo, los métodos de preparación y la variedad del catálogo. Incluye sección de ubicación y llamada de acción clara para hacer un pedido o visitar el local.',
    palette: ['#F3EAD9', '#B85C38', '#2A1E16', '#E7A879'],
    stack: ['HTML', 'Tailwind CSS', 'JavaScript'],
    imageGradient: 'linear-gradient(135deg, #F3EAD9 0%, #B85C38 50%, #2A1E16 100%)',
    liveUrl: 'https://cafe-senor-martin.vercel.app/',
    repoUrl: 'https://github.com/sogom01/cafe-san-martin',
    previewImage: '/projects/señor-martin.preview.webp',
  },
  {
    name: 'Marfil',
    category: 'Clínica dental · Salud',
    tagline: 'Sonríe con total confianza.',
    description:
      'Landing para clínica dental que transmite confianza desde el primer scroll: servicios detallados, credenciales del equipo y preguntas frecuentes respondidas. El formulario de agendamiento conectado a Supabase permite solicitar cita en línea sin necesidad de llamar.',
    palette: ['#EEF5F7', '#15B5AE', '#0E3A47', '#D7EFEC'],
    stack: ['Astro', 'TypeScript', 'Tailwind CSS', 'Supabase', 'Zod', 'Vercel'],
    imageGradient: 'linear-gradient(135deg, #EEF5F7 0%, #15B5AE 70%, #0E3A47 100%)',
    liveUrl: 'https://marfil-dental.vercel.app',
    repoUrl: 'https://github.com/sogom01/marfil-dental',
    previewImage: '/projects/marfil-preview.webp',
  },
  {
    name: 'FORJA',
    category: 'Centro de entrenamiento · Fitness',
    tagline: 'Tu mejor versión se forja aquí.',
    description:
      'Landing para gimnasio funcional diseñada para convertir. Presenta planes de membresía, clases disponibles y testimonios reales de miembros. Cada sección empuja al visitante hacia un único objetivo: dar el primer paso y registrarse sin excusas.',
    palette: ['#0B0C0E', '#CCFF00', '#191C21', '#F4F6F4'],
    stack: ['HTML', 'Tailwind CSS', 'JavaScript'],
    imageGradient: 'linear-gradient(135deg, #0B0C0E 0%, #191C21 60%, #CCFF00 100%)',
    liveUrl: 'https://forja-gym.vercel.app/',
    repoUrl: 'https://github.com/sogom01/forja-gym',
    previewImage: '/projects/forja-gym.preview.webp',
  },
  {
    name: 'Pan y Ricuras',
    category: 'Carta digital · Panadería',
    tagline: 'Bienvenido — explora nuestra carta.',
    description:
      'Carta digital para panadería con búsqueda y filtrado por categoría en tiempo real. El cliente consulta el menú desde su celular sin instalar nada. El administrador gestiona el catálogo desde un panel protegido: agrega, edita, marca agotados y elimina productos sin tocar una línea de código.',
    palette: ['#1a0f07', '#c99e4c', '#f5ead8', '#4a7c59'],
    stack: ['Next.js', 'TypeScript', 'Tailwind CSS', 'Supabase', 'Zod', 'Vercel'],
    imageGradient: 'linear-gradient(135deg, #1a0f07 0%, #2e1c0a 50%, #c99e4c 100%)',
    liveUrl: 'https://pan-y-ricuras-chipre.vercel.app/',
    repoUrl: 'https://github.com/sogom01/pan-y-ricuras-chipre',
    previewImage: '/projects/pan-y-ricuras-preview.webp',
  },
  {
    name: 'Motor Store',
    category: 'E-commerce · Repuestos de moto',
    tagline: 'Todo lo que tu moto necesita, en un solo lugar.',
    description:
      'Tienda online de repuestos y accesorios para moto. El usuario navega el catálogo, filtra por categoría y precio, revisa el detalle de cada producto y gestiona su carrito — que persiste entre recargas. Alertas de stock bajo para crear urgencia y reducir el abandono.',
    palette: ['#030000', '#9f1239', '#e11d48', '#f43f5e'],
    stack: ['Next.js', 'TypeScript', 'Tailwind CSS', 'Supabase', 'Zod', 'Vercel'],
    imageGradient: 'linear-gradient(135deg, #030000 0%, #9f1239 60%, #e11d48 100%)',
    liveUrl: 'https://motorstore.vercel.app//',
    repoUrl: 'https://github.com/sogom01/motor-store',
    previewImage: '/projects/motorstore-preview.webp',
  },
  {
    name: 'AdminInvent',
    category: 'Gestión empresarial · Inventario',
    tagline: 'Tu inventario, bajo control real.',
    description:
      'App web de gestión de inventario con roles diferenciados (admin, gestor y visor). Permite registrar productos, registrar entradas y salidas de stock, y consultar el historial de movimientos desde un dashboard limpio. Autenticación segura con Auth.js, datos persistidos en PostgreSQL vía Prisma y validaciones compartidas con Zod en front y back.',
    palette: ['#0f172a', '#10b981', '#1e293b', '#d1fae5'],
    stack: ['Next.js', 'TypeScript', 'PostgreSQL', 'Prisma', 'Zod', 'Vercel'],
    imageGradient: 'linear-gradient(135deg, #0f172a 0%, #1e293b 55%, #10b981 100%)',
    status: 'building',
  },
  {
    name: 'Teclook',
    category: 'Agencia · Marketing & Software',
    tagline: 'Tecnología con mirada estratégica.',
    description:
      'Sitio corporativo para Teclook donde los clientes potenciales descubren los servicios de marketing y desarrollo de software, exploran casos de éxito y contactan al equipo directamente. Cada sección está pensada para generar confianza rápido y convertir una visita en una conversación real.',
    palette: ['#0A0A0F', '#6C63FF', '#F5F5FF', '#1A1A2E'],
    stack: ['Astro', 'TypeScript', 'Tailwind CSS', 'Vercel'],
    imageGradient: 'linear-gradient(135deg, #0A0A0F 0%, #1A1A2E 50%, #6C63FF 100%)',
    status: 'building',
    liveUrl: 'https://teclook.vercel.app//',
    repoUrl: 'https://github.com/sogom01/teclook',
    previewImage: '/projects/tecklook.preview.webp',
  },
];

// Mapa de iconos de tecnología — Simple Icons CDN (cdn.simpleicons.org/{slug}/{hex})
// Usamos Map en lugar de objeto plano para evitar la regla security/detect-object-injection
// invertDark: true → el icono es negro en su color de marca; se invierte en dark mode
type TechIcon = { slug: string; color?: string; invertDark?: boolean };
const techIconMap = new Map<string, TechIcon>([
  ['Astro', { slug: 'astro', color: 'FF5D01' }],
  ['TypeScript', { slug: 'typescript', color: '3178C6' }],
  ['Tailwind CSS', { slug: 'tailwindcss', color: '06B6D4' }],
  ['Supabase', { slug: 'supabase', color: '3ECF8E' }],
  ['Zod', { slug: 'zod', color: '3E67B1' }],
  ['Vercel', { slug: 'vercel', invertDark: true }],
  ['Next.js', { slug: 'nextdotjs', invertDark: true }],
  ['HTML', { slug: 'html5', color: 'E34F26' }],
  ['JavaScript', { slug: 'javascript', color: 'F7DF1E' }],
  ['Prisma', { slug: 'prisma', invertDark: true }],
  ['PostgreSQL', { slug: 'postgresql', color: '4169E1' }],
]);

// Etiquetas dinámicas por status
const statusLabels: Record<ConceptStatus, { text: string; bgClass: string }> = {
  concept: { text: 'Concepto', bgClass: 'bg-white/90 text-[var(--color-fg)]' },
  building: {
    text: 'En desarrollo',
    bgClass: 'bg-gradient-to-r from-[var(--color-accent)] to-[var(--color-accent-2)] text-white',
  },
};

// Un concepto con liveUrl siempre se muestra como "En línea"
const getBadge = (c: Concept) => {
  if (c.liveUrl) return { text: 'En línea', bgClass: 'bg-green-600/90 text-white' };
  return statusLabels[c.status ?? 'concept'];
};
---

<BaseLayout
  title="Proyectos"
  description="Trabajos reales y conceptos de muestra de Juan Sebastián Osorio (sogom). Casos de estudio con proceso documentado."
>
  <section class="py-12 sm:py-20">
    <p
      class="fade-in-up eyebrow-dot mb-6 inline-flex items-center text-xs font-medium tracking-wider uppercase"
    >
      Proyectos
    </p>
    <h1
      class="fade-in-up fade-in-up-delay-1 max-w-3xl text-5xl leading-[1.05] font-semibold tracking-tight text-balance sm:text-6xl lg:text-7xl"
    >
      Trabajos reales,
      <span class="italic-accent">contados con claridad</span>.
    </h1>
    <p
      class="fade-in-up fade-in-up-delay-2 mt-6 max-w-2xl text-lg text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]"
    >
      Esta sección crecerá rápido. Te muestro lo que ya está en producción y los conceptos de diseño
      que tengo listos para ser tu próximo proyecto.
    </p>
  </section>

  <!-- DESTACADO -->
  <section aria-labelledby="featured-title" class="pb-16">
    <h2 id="featured-title" class="sr-only">Proyecto destacado</h2>

    <article
      class="reveal gradient-border rounded-2xl bg-gradient-to-br from-[var(--color-accent)]/[0.03] to-[var(--color-accent-2)]/[0.03] p-8 sm:p-10 dark:from-[var(--color-accent)]/[0.06] dark:to-[var(--color-accent-2)]/[0.06]"
    >
      <div class="flex flex-wrap items-center gap-3">
        <span
          class="inline-flex rounded-full bg-green-600/15 px-3 py-0.5 text-xs font-semibold text-green-700 dark:text-green-400"
        >
          En línea
        </span>
        <span
          class="text-xs tracking-wider text-[var(--color-muted)] uppercase dark:text-[var(--color-muted-dark)]"
        >
          Caso de muestra
        </span>
      </div>

      <h3 class="mt-5 text-3xl font-semibold tracking-tight sm:text-4xl">
        {featured.title}
      </h3>
      <p class="mt-2 text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]">
        {featured.subtitle}
      </p>

      <p
        class="mt-6 max-w-3xl text-lg leading-relaxed text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]"
      >
        {featured.description}
      </p>

      <div class="mt-8">
        <h4 class="text-xs font-semibold tracking-wider uppercase">Construida con</h4>
        <ul class="mt-3 flex flex-wrap gap-2">
          {
            featured.stack.map((tech) => (
              <li class="rounded-md border border-[var(--color-border)] px-3 py-1 text-xs dark:border-[var(--color-border-dark)]">
                {tech}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="mt-8">
        <h4 class="text-xs font-semibold tracking-wider uppercase">Lo que recibes</h4>
        <ul class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-2">
          {
            featured.highlights.map((h) => (
              <li class="flex gap-3 text-sm">
                <svg
                  class="h-5 w-5 shrink-0 text-[var(--color-accent)]"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  aria-hidden="true"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7" />
                </svg>
                <span>{h}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="mt-10 flex flex-wrap gap-3">
        {
          featured.liveUrl && (
            <a
              href={featured.liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="glow-on-hover inline-flex items-center justify-center rounded-md bg-[var(--color-accent)] px-6 py-3 text-sm font-medium text-white shadow-sm transition-colors hover:bg-[var(--color-accent-hover)]"
            >
              Ver la web en vivo ↗
            </a>
          )
        }
        {
          featured.repoUrl && (
            <a
              href={featured.repoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center rounded-md border border-[var(--color-border)] px-6 py-3 text-sm font-medium text-[var(--color-fg)] transition-colors hover:border-[var(--color-accent)] dark:border-[var(--color-border-dark)] dark:text-[var(--color-fg-dark)]"
            >
              Revisar el código ↗
            </a>
          )
        }
      </div>
    </article>
  </section>

  <!-- CONCEPTOS DE DISEÑO -->
  <section
    aria-labelledby="concepts-title"
    class="border-t border-[var(--color-border)] py-16 sm:py-20 dark:border-[var(--color-border-dark)]"
  >
    <div class="reveal flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-2xl">
        <p
          class="eyebrow-dot mb-4 inline-flex items-center text-xs font-medium tracking-wider uppercase"
        >
          Conceptos y proyectos en curso
        </p>
        <h2 id="concepts-title" class="text-3xl font-semibold tracking-tight sm:text-4xl">
          Varios mundos, una misma <span class="italic-accent">forma de trabajar</span>.
        </h2>
        <p class="mt-4 text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]">
          Apps en producción y conceptos listos para implementar. Cada proyecto resuelve un problema
          real de negocio: vender, mostrar productos, gestionar un catálogo o posicionar una marca.
          El stack y el diseño cambian según la industria; la atención al detalle, siempre la misma.
        </p>
      </div>
    </div>

    <div class="mt-14 grid grid-cols-1 gap-6 md:grid-cols-2">
      {
        concepts.map((c, i) => (
          <article
            class={`reveal reveal-delay-${Math.min(i, 3)} lift group flex flex-col overflow-hidden rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg)] dark:border-[var(--color-border-dark)] dark:bg-[var(--color-bg-dark)]`}
          >
            {/* Miniatura: screenshot local para proyectos en línea, gradiente para conceptos */}
            {c.previewImage ? (
              <div class="relative flex h-48 flex-col overflow-hidden" aria-hidden="true">
                {/* Barra de navegador estilo macOS */}
                <div class="flex shrink-0 items-center gap-1.5 bg-[#1a1a1a] px-3 py-1.5">
                  <span class="h-2 w-2 rounded-full bg-[#ff5f57]" />
                  <span class="h-2 w-2 rounded-full bg-[#febc2e]" />
                  <span class="h-2 w-2 rounded-full bg-[#28c840]" />
                  <span class="ml-1 flex-1 truncate rounded bg-[#2d2d2d] px-2 py-0.5 text-[9px] text-gray-400">
                    {c.liveUrl?.replace('https://', '')}
                  </span>
                </div>
                {/* Screenshot local */}
                <div class="relative flex-1 overflow-hidden">
                  <img
                    src={c.previewImage}
                    alt={`Vista previa de ${c.name}`}
                    class="h-full w-full object-cover object-top transition-transform duration-700 group-hover:scale-105"
                    loading="lazy"
                  />
                  <div class="absolute top-3 left-3">
                    <span
                      class:list={[
                        'inline-flex rounded-full px-2.5 py-0.5 text-[10px] font-semibold tracking-wider uppercase shadow-sm backdrop-blur-sm',
                        getBadge(c).bgClass,
                      ]}
                    >
                      {getBadge(c).text}
                    </span>
                  </div>
                </div>
              </div>
            ) : (
              <div
                class="relative h-48 overflow-hidden"
                style={`background: ${c.imageGradient};`}
                aria-hidden="true"
              >
                <div class="absolute inset-0 bg-[radial-gradient(circle_at_25%_30%,rgba(255,255,255,0.18),transparent_55%)]" />
                <div class="absolute right-5 bottom-5 flex gap-1.5">
                  {c.palette.map((color) => (
                    <span
                      class="h-5 w-5 rounded-full border border-white/40 shadow-sm"
                      style={`background: ${color};`}
                    />
                  ))}
                </div>
                <div class="absolute top-5 left-5">
                  <span
                    class:list={[
                      'inline-flex rounded-full px-2.5 py-0.5 text-[10px] font-semibold tracking-wider uppercase shadow-sm backdrop-blur-sm',
                      getBadge(c).bgClass,
                    ]}
                  >
                    {getBadge(c).text}
                  </span>
                </div>
              </div>
            )}

            <div class="flex flex-1 flex-col p-7">
              <p class="text-xs tracking-wider text-[var(--color-muted)] uppercase dark:text-[var(--color-muted-dark)]">
                {c.category}
              </p>
              <h3 class="mt-2 text-2xl font-semibold tracking-tight">{c.name}</h3>
              <p class="mt-1 font-serif text-sm text-[var(--color-accent)] italic">"{c.tagline}"</p>
              <p class="mt-4 flex-1 text-sm text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]">
                {c.description}
              </p>
              <div class="mt-5">
                <p class="text-[10px] font-semibold tracking-wider text-[var(--color-muted)] uppercase dark:text-[var(--color-muted-dark)]">
                  Stack
                </p>
                <ul class="mt-2 flex flex-wrap gap-2">
                  {c.stack.map((s) => {
                    const tech = techIconMap.get(s);
                    const src = tech
                      ? `https://cdn.simpleicons.org/${tech.slug}${tech.color ? '/' + tech.color : ''}`
                      : undefined;
                    return (
                      <li class="group flex flex-col items-center gap-1 rounded-xl border border-[var(--color-border)] px-3 py-2 transition-all duration-200 hover:-translate-y-0.5 hover:border-[var(--color-accent)]/40 hover:shadow-sm dark:border-[var(--color-border-dark)]">
                        {src ? (
                          <img
                            src={src}
                            alt={s}
                            width="20"
                            height="20"
                            class:list={[
                              'shrink-0 transition-transform duration-200 group-hover:scale-110',
                              { 'dark:invert': tech?.invertDark },
                            ]}
                            loading="lazy"
                          />
                        ) : (
                          <span class="flex h-5 w-5 items-center justify-center text-sm font-bold text-[var(--color-accent)]">
                            {s.charAt(0)}
                          </span>
                        )}
                        <span class="text-[10px] leading-none text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]">
                          {s}
                        </span>
                      </li>
                    );
                  })}
                </ul>
              </div>
              {(c.liveUrl || c.repoUrl) && (
                <div class="mt-6 flex flex-wrap gap-3">
                  {c.liveUrl && (
                    <a
                      href={c.liveUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="glow-on-hover inline-flex items-center justify-center gap-2 rounded-md bg-[var(--color-accent)] px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-[var(--color-accent-hover)]"
                    >
                      Ver sitio en vivo ↗
                    </a>
                  )}
                  {c.repoUrl && (
                    <a
                      href={c.repoUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center justify-center rounded-md border border-[var(--color-border)] px-5 py-2.5 text-sm font-medium text-[var(--color-fg)] transition-colors hover:border-[var(--color-accent)] dark:border-[var(--color-border-dark)] dark:text-[var(--color-fg-dark)]"
                    >
                      Ver código ↗
                    </a>
                  )}
                </div>
              )}
            </div>
          </article>
        ))
      }
    </div>

    <p
      class="reveal mt-10 max-w-2xl text-sm text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]"
    >
      Cualquiera de estos conceptos se puede adaptar a tu marca. Si te interesa alguno, hablemos y
      lo convertimos en tu web.
    </p>
  </section>

  <section
    class="border-t border-[var(--color-border)] py-16 sm:py-20 dark:border-[var(--color-border-dark)]"
  >
    <div
      class="reveal flex flex-col items-start gap-6 sm:flex-row sm:items-center sm:justify-between"
    >
      <div>
        <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">
