# =====================================================================
# .env.example — Plantilla de variables de entorno
# ---------------------------------------------------------------------
# Copia este archivo a `.env` y rellena los valores reales.
# NUNCA commitees el archivo .env real. El .gitignore ya lo protege.
# En producción (Vercel), configura estas variables desde el panel:
# https://vercel.com/<tu-usuario>/<proyecto>/settings/environment-variables
# =====================================================================

# --- Envío de email (formulario de contacto) ----------------------------
# Servicio: Resend (https://resend.com) — tier gratuito: 3000 emails/mes
# Esta API key DEBE tener scope mínimo: solo "send" del dominio configurado.
RESEND_API_KEY="re_replace_me"

# Email de destino donde recibirás los mensajes del formulario.
CONTACT_TO_EMAIL="sog981@gmail.com"

# Email remitente verificado en Resend (NO uses tu inbox personal).
# Ejemplo: "contacto@tudominio.com" o "onboarding@resend.dev" para pruebas.
CONTACT_FROM_EMAIL="onboarding@resend.dev"

# --- Anti-spam / Anti-bot (Cloudflare Turnstile, gratis) ----------------
# Crea un widget en: https://dash.cloudflare.com/?to=/:account/turnstile
# Site key es PÚBLICA (va en el HTML). Secret key es PRIVADA (solo servidor).
PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAAA_replace_me"
TURNSTILE_SECRET_KEY="0x4AAAAAAA_replace_me_secret"

# --- Rate limiting (opcional, fase 2) ----------------------------------
# Upstash Redis serverless (tier gratuito) — descomenta cuando lo añadas
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# --- Configuración pública del sitio -----------------------------------
# Prefix PUBLIC_ expone la variable al cliente (Astro/Vite). Nunca pongas
# secretos detrás de PUBLIC_*. Solo datos que pueden ser visibles.
PUBLIC_SITE_URL="https://portafolio-jso.vercel.app"
